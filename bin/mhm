#!/usr/bin/env bash
# bin/mhm — Meta-Harness Manager CLI
# Empowers developers to build, audit, install, and evolve custom AI agent harnesses.
set -euo pipefail

VERSION="0.2.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

show_help() {
  cat << 'EOF'
MHM — My Harness Manager (Meta-Harness CLI)
A harness to design, audit, deploy, and evolve your AI agent harnesses.

Usage:
  mhm <command> [arguments] [options]

Commands:
  install [path]    Install a self-evolving 3-pillar harness into a target directory (default: .)
  init <name>       Scaffold a brand-new custom harness repository
  audit [path]      Audit a harness for token bloat, missing gates, and anti-patterns
  cases             List and view structural case studies of archetypal harnesses
  help, -h          Show this help message
  version, -v       Show MHM version

Examples:
  mhm install                          # Deploy harness to current directory
  mhm install /path/to/my-agent-repo   # Deploy harness to specific agent folder
  mhm init my-team-harness             # Scaffold new harness project
  mhm audit /path/to/target            # Audit harness health
  mhm cases                            # View reference case studies
EOF
}

cmd_install() {
  local target_dir="${1:-.}"
  mkdir -p "$target_dir"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🚀 [MHM] Installing Self-Evolving Harness into: $target_dir"
  echo "──────────────────────────────────────────────"

  # 1. Install Rules
  echo "📜 Installing Rules..."
  local rules_target="$target_dir/.agents/rules"
  mkdir -p "$rules_target"

  if [ -d "$SCRIPT_DIR/rules" ]; then
    for rf in "$SCRIPT_DIR/rules/"*.md; do
      [ -f "$rf" ] || continue
      local bname
      bname="$(basename "$rf")"
      cp "$rf" "$rules_target/$bname"
      echo "   📄 Installed rule: .agents/rules/$bname"
    done
  fi

  # Auto-wire AGENTS.md
  local agents_md="$target_dir/.agents/AGENTS.md"
  if [ ! -f "$agents_md" ]; then
    cat << 'EOF' > "$agents_md"
# Agent Operating Rules (AGENTS.md)

This project is governed by the 3 Pillars (Rule, Skill, Hook) and 3 Invariants.

## Active Rules
EOF
    echo "   📝 Created: .agents/AGENTS.md"
  fi

  for rf in "$rules_target/"*.md; do
    [ -f "$rf" ] || continue
    local bname
    bname="$(basename "$rf")"
    if ! grep -q "@rules/$bname" "$agents_md"; then
      echo "@rules/$bname" >> "$agents_md"
      echo "   🔌 Wired '$bname' into .agents/AGENTS.md"
    fi
  done

  # Wire Claude and Gemini configs
  mkdir -p "$target_dir/.claude" "$target_dir/.gemini"
  [ ! -f "$target_dir/.claude/CLAUDE.md" ] && echo "@../.agents/AGENTS.md" > "$target_dir/.claude/CLAUDE.md"
  [ ! -f "$target_dir/.gemini/GEMINI.md" ] && echo "@../.agents/AGENTS.md" > "$target_dir/.gemini/GEMINI.md"

  # 2. Install Skills
  echo "🧰 Installing Skills (including self-evolution)..."
  local skills_target="$target_dir/.agents/skills"
  mkdir -p "$skills_target"

  if [ -d "$SCRIPT_DIR/skills" ]; then
    for sd in "$SCRIPT_DIR/skills/"*; do
      [ -d "$sd" ] || continue
      local sname
      sname="$(basename "$sd")"
      mkdir -p "$skills_target/$sname"
      cp -R "$sd/"* "$skills_target/$sname/"
      echo "   📁 Installed skill: .agents/skills/$sname"
    done
  fi

  # Wire .claude/skills symlink
  if [ ! -L "$target_dir/.claude/skills" ]; then
    rm -rf "$target_dir/.claude/skills"
    ln -sf "../.agents/skills" "$target_dir/.claude/skills"
    echo "   🔌 Wired: .claude/skills -> ../.agents/skills"
  fi

  # 3. Install Git Hooks
  if [ -d "$target_dir/.git" ]; then
    echo "🪝 Installing Git hooks..."
    local hooks_target="$target_dir/.git/hooks"
    mkdir -p "$hooks_target"

    if [ -d "$SCRIPT_DIR/hooks" ]; then
      if [ -f "$SCRIPT_DIR/hooks/install.sh" ]; then
        bash "$SCRIPT_DIR/hooks/install.sh" "$target_dir" >/dev/null 2>&1 || true
      fi
    fi
    git -C "$target_dir" config core.hooksPath .git/hooks 2>/dev/null || true
    echo "   ✅ Installed hooks: commit-msg, pre-commit"
  fi

  echo "──────────────────────────────────────────────"
  echo "✨ [MHM] Self-evolving harness successfully installed!"
  echo "   The agent in this folder is now governed by 3-Pillar rules and"
  echo "   mandated to continuously evolve its own harness via harness-evolution.md."
}

cmd_init() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "❌ Error: Please specify a harness name."
    echo "   Usage: mhm init <harness-name>"
    exit 1
  fi

  local target_dir
  if [[ "$name" = /* ]]; then
    target_dir="$name"
  else
    target_dir="./$name"
  fi
  local base_name
  base_name="$(basename "$name")"

  if [ -d "$target_dir" ]; then
    echo "❌ Error: Directory '$target_dir' already exists."
    exit 1
  fi

  echo "🚀 [MHM] Scaffolding new 3-Pillar Harness: $base_name at $target_dir..."
  mkdir -p "$target_dir/rules" "$target_dir/skills/harness-evolution" "$target_dir/hooks/commit-msg" "$target_dir/hooks/pre-commit" "$target_dir/docs"

  # Copy base rules and self-evolution rule
  if [ -d "$SCRIPT_DIR/rules" ]; then
    cp "$SCRIPT_DIR/rules/"*.md "$target_dir/rules/" 2>/dev/null || true
  fi

  # Copy harness-evolution skill
  if [ -d "$SCRIPT_DIR/skills/harness-evolution" ]; then
    cp -R "$SCRIPT_DIR/skills/harness-evolution/"* "$target_dir/skills/harness-evolution/"
  fi

  # Copy hooks
  if [ -d "$SCRIPT_DIR/hooks" ]; then
    cp -R "$SCRIPT_DIR/hooks/"* "$target_dir/hooks/" 2>/dev/null || true
  fi

  # Copy install script from SCRIPT_DIR or generate
  cat << 'EOF' > "$target_dir/install.sh"
#!/usr/bin/env bash
# install.sh — Idempotent installer for custom harness
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${1:-.}"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

echo "🚀 Installing harness to: $TARGET_DIR"

# 1. Install Git Hooks
if [ -d "$TARGET_DIR/.git" ]; then
  mkdir -p "$TARGET_DIR/.git/hooks"
  [ -f "$SCRIPT_DIR/hooks/commit-msg/commit-msg" ] && cp "$SCRIPT_DIR/hooks/commit-msg/commit-msg" "$TARGET_DIR/.git/hooks/commit-msg"
  [ -f "$SCRIPT_DIR/hooks/pre-commit/pre-commit" ] && cp "$SCRIPT_DIR/hooks/pre-commit/pre-commit" "$TARGET_DIR/.git/hooks/pre-commit"
  chmod +x "$TARGET_DIR/.git/hooks/"* 2>/dev/null || true
  git -C "$TARGET_DIR" config core.hooksPath .git/hooks 2>/dev/null || true
  echo "   ✅ Installed Git hooks"
fi

# 2. Install Rules
mkdir -p "$TARGET_DIR/.agents/rules"
cp "$SCRIPT_DIR/rules/"*.md "$TARGET_DIR/.agents/rules/" 2>/dev/null || true

# Auto-wire AGENTS.md
AGENTS_MD="$TARGET_DIR/.agents/AGENTS.md"
[ ! -f "$AGENTS_MD" ] && touch "$AGENTS_MD"

for rule in "$TARGET_DIR/.agents/rules/"*.md; do
  [ -f "$rule" ] || continue
  base="$(basename "$rule")"
  if ! grep -q "@rules/$base" "$AGENTS_MD"; then
    echo "@rules/$base" >> "$AGENTS_MD"
  fi
done

# Wire AI tool configs
mkdir -p "$TARGET_DIR/.claude" "$TARGET_DIR/.gemini"
[ ! -f "$TARGET_DIR/.claude/CLAUDE.md" ] && echo "@../.agents/AGENTS.md" > "$TARGET_DIR/.claude/CLAUDE.md"
[ ! -f "$TARGET_DIR/.gemini/GEMINI.md" ] && echo "@../.agents/AGENTS.md" > "$TARGET_DIR/.gemini/GEMINI.md"

# 3. Install Skills
mkdir -p "$TARGET_DIR/.agents/skills"
for sd in "$SCRIPT_DIR/skills/"*; do
  [ -d "$sd" ] || continue
  sname="$(basename "$sd")"
  mkdir -p "$TARGET_DIR/.agents/skills/$sname"
  cp -R "$sd/"* "$TARGET_DIR/.agents/skills/$sname/"
done
ln -sf "../.agents/skills" "$TARGET_DIR/.claude/skills" 2>/dev/null || true

echo "✨ Harness installed successfully."
EOF
  chmod +x "$target_dir/install.sh"

  cat << EOF > "$target_dir/README.md"
# $base_name

A self-evolving 3-Pillar AI Agent Harness built with [MHM (My Harness Manager)](https://github.com/2JIHAN/my-harness-manager).

## Architecture

- **\`rules/\`** — Always-on operational standards, skill routing, and self-evolution protocol
- **\`skills/\`** — On-demand domain capabilities and evolution playbook
- **\`hooks/\`** — Git-level deterministic hard gates (commit-msg, pre-commit)

## Installation

\`\`\`bash
./install.sh /path/to/target-project
\`\`\`
EOF

  echo "✨ Harness '$base_name' scaffolded successfully at $target_dir"
  echo "   Includes 'rules/harness-evolution.md' for agent continuous self-improvement."
}

cmd_audit() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🔍 [MHM Audit] Auditing harness at: $target_dir"
  echo "──────────────────────────────────────────────"

  local issues=0

  # 1. Check Rules
  echo "📜 Auditing Rules..."
  local rules_dir="$target_dir/rules"
  if [ ! -d "$rules_dir" ] && [ -d "$target_dir/.agents/rules" ]; then
    rules_dir="$target_dir/.agents/rules"
  fi

  local has_evolution=0
  if [ -d "$rules_dir" ]; then
    for rf in "$rules_dir/"*.md; do
      [ -f "$rf" ] || continue
      local lines
      lines=$(wc -l < "$rf" | tr -d ' ')
      local bname
      bname=$(basename "$rf")

      if [ "$bname" = "harness-evolution.md" ]; then
        has_evolution=1
      fi

      if [ "$lines" -gt 100 ]; then
        echo "   ⚠️  [Token Warning] '$bname' is $lines lines. Always-on rules should remain < 100 lines."
        echo "       Consider moving large guides to an on-demand Skill and using a Skill Router."
        issues=$((issues + 1))
      else
        echo "   ✅ '$bname' ($lines lines) — Clean size"
      fi
    done
  else
    echo "   ⚠️  No 'rules/' directory found."
    issues=$((issues + 1))
  fi

  if [ "$has_evolution" -eq 1 ]; then
    echo "   🌟 Self-evolution rule (harness-evolution.md) is ACTIVE"
  else
    echo "   ℹ️  Self-evolution rule not found. Agent cannot autonomously maintain its harness."
  fi

  # 2. Check Skills
  echo "🧰 Auditing Skills..."
  local skills_dir="$target_dir/skills"
  if [ ! -d "$skills_dir" ] && [ -d "$target_dir/.agents/skills" ]; then
    skills_dir="$target_dir/.agents/skills"
  fi

  if [ -d "$skills_dir" ]; then
    for sd in "$skills_dir/"*; do
      [ -d "$sd" ] || continue
      local sname
      sname=$(basename "$sd")
      if [ ! -f "$sd/SKILL.md" ]; then
        echo "   ❌ '$sname' is missing SKILL.md specification file."
        issues=$((issues + 1))
      else
        echo "   ✅ '$sname/SKILL.md' present"
      fi
    done
  else
    echo "   ℹ️  No skills directory found."
  fi

  # 3. Check Hooks
  echo "🪝 Auditing Hooks..."
  local hooks_dir="$target_dir/hooks"
  if [ ! -d "$hooks_dir" ] && [ -d "$target_dir/.git/hooks" ]; then
    hooks_dir="$target_dir/.git/hooks"
  fi

  if [ -d "$hooks_dir" ]; then
    for hk in "$hooks_dir/"*; do
      [ -e "$hk" ] || continue
      local hname
      hname=$(basename "$hk")
      [[ "$hname" == *.sample ]] && continue
      if [ -f "$hk" ]; then
        if [ ! -x "$hk" ]; then
          echo "   ⚠️  Hook '$hname' is not executable (chmod +x needed)."
          issues=$((issues + 1))
        else
          echo "   ✅ Hook '$hname' verified"
        fi
      fi
    done
  else
    echo "   ℹ️  No hooks found."
  fi

  echo "──────────────────────────────────────────────"
  if [ "$issues" -eq 0 ]; then
    echo "✨ Audit clean! Harness adheres to 3-Pillar, minimal token, and self-evolution standards."
  else
    echo "⚠️  Found $issues recommendation(s). Review findings above."
  fi
}

cmd_cases() {
  echo "📚 [MHM Case Studies] Archetypal Harness Analyses"
  echo "──────────────────────────────────────────────"
  echo "1. Jihan Harness       — docs/case-studies/01-jihan-harness.md"
  echo "   • Lean 3-Pillar architecture, Skill Dispatcher pattern, zero dependencies"
  echo "2. Everything Claude   — docs/case-studies/02-everything-claude-code.md"
  echo "   • Agentic OS, PreToolUse/Stop lifecycle hooks, config-protection"
  echo "3. Superpowers (obra)  — docs/case-studies/03-obra-superpowers.md"
  echo "   • Iron Law of debugging, TDD cycle, anti-symptom-patching"
  echo "4. Ponytail (Dietrich) — docs/case-studies/04-dietrich-ponytail.md"
  echo "   • Ladder of Laziness, complexity review, ponytail-debt ledger"
  echo "──────────────────────────────────────────────"
  echo "View full details in $SCRIPT_DIR/docs/case-studies/"
}

case "${1:-}" in
  install)
    cmd_install "${2:-.}"
    ;;
  init)
    cmd_init "${2:-}"
    ;;
  audit)
    cmd_audit "${2:-.}"
    ;;
  cases)
    cmd_cases
    ;;
  version|-v)
    echo "mhm v$VERSION"
    ;;
  help|-h|"")
    show_help
    ;;
  *)
    echo "❌ Unknown command: $1"
    show_help
    exit 1
    ;;
esac
