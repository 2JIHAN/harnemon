#!/usr/bin/env bash
# bin/harnemon — Harnemon CLI
# The Pokémon-Style, Zero-Dependency Autonomous Harness Companion for AI Coding Agents.
set -euo pipefail

VERSION="0.9.3"

resolve_script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
GLOBAL_HOME="${HOME}/.harnemon"

show_help() {
  cat << 'EOF'
  ⚡ HARNEMON ⚡
  The Pokémon-Style, Zero-Dependency Autonomous Harness Companion

Usage:
  harnemon <command> [arguments] [options]

Commands:
  setup, global            Set up global belt & register Harnemon awareness to ~/.agents/AGENTS.md
  update, upgrade [path]   Update Harnemon global belt, refresh agent awareness, & sync project rules
  adopt [species] [path]   Adopt a Harnemon starter or add an additional specialist to your party
  party [path]             View your project's Harnemon Party lineup (up to 6 members)
  switch <species> [path]  Switch the Active Lead partner in your project party
  dismiss <species> [path] Dismiss a member from your project party
  release [path] [-y]      Release the partner: delete .harnemons/ and unwire this project
  incubate, egg [path]     Awaken a blank Harnemon Egg 🥚 to incubate and evolve via 2-correction feedback
  hatch <name> [options]   Hatch the incubated egg into a named mature Harnemon species (e.g. Supabird ⚡)
  register [path]          Register your mature Harnemon species to global Harnedex (~/.harnemon/catalog/)
  status [path]            Check your active partner & party profile, abilities, and moves
  draw [species] [path]    Draw the partner sprite: writes sprite.json & avatar.svg, prints it in color
  note "<text>" [--type]   Record what the Harnemon just learned into today's episode log
  rest [path] [--apply]    Tend distilled memory: flag promoted, duplicate, and uncited entries
  audit [path]             Diagnose Harnemon health, token bloat, and rule integrity
  feed [--link] [path]     Feed a Harness Pill to awaken a Harnemon in a target folder
  link [path]              Zero-dependency link: bind project to global Harnemon belt (~/.harnemon)
  sync [path]              Cross-pollinate: sync locally learned moves back to global Harnedex
  dex                      Open the Harnedex to inspect legendary archetypes and custom species
  init <name>              Scaffold a new custom Harnemon species repository
  help, -h                 Show this help message
  version, -v              Show Harnemon version

The Pokémon Architecture:
  • Global Harnemon = Class / Species (Master blueprint / The species 'Pikachu')
  • Project Harnemon = Instance / Individual (Adopted into this repo to evolve / 'Ash's Pikachu')
  • Incubation System = Blank Egg (0 rules/skills) ──▶ Hermes 2-Correction Loop ──▶ Mature Hatched Species
  • Zero Dependencies: 100% POSIX Bash & Git, 0 npm/pip/cargo packages required

Examples:
  harnemon incubate                    # Start with a blank egg and evolve it through coding
  harnemon hatch "Supabird" -t "DB ⚡" # Hatch the mature egg into a custom species
  harnemon register                    # Save the new species to global Harnedex
  harnemon adopt                       # Interactive starter selection (Egg or 4 Starters)
  harnemon note "Always run pnpm build" # Record a correction and raise hatch readiness
  harnemon rest                        # Review memory and see what is safe to retire
  harnemon status                      # View current partner profile or egg incubation progress
  harnemon draw --force                # Redraw the partner sprite from scratch
  harnemon audit                       # Health-check your partner
  harnemon dex                         # Browse Harnedex
  harnemon release                     # Release the partner and unwire the project
EOF
}

choose_starter_interactive() {
  local options=(
    "nimbleet:⚡ Nimbleet [Electric ⚡] — 50-token skill router, ultralight minimal speedster"
    "fortoise:💧 Fortoise [Water 💧]    — Giant tool fortress, impenetrable config-guard shell"
    "monkin:🔥 Monkin   [Fire 🔥]     — The Iron Law discipline, burns away guessing with proofs"
    "yagni:🍃 Yagni    [Grass 🍃]    — Ladder of Laziness, prunes code bloat (-N lines)"
    "egg:🥚 Harnemon Egg [Incubating 🌱] — Blank canvas, self-evolving custom companion"
  )
  local num_options=${#options[@]}
  local selected=0

  local tty_in="/dev/stdin"
  if [ -t 0 ] && [ -c /dev/tty ]; then
    tty_in="/dev/tty"
  fi

  local ESC=$'\033'
  local HIDE_CURSOR="${ESC}[?25l"
  local SHOW_CURSOR="${ESC}[?25h"
  local BOLD="${ESC}[1m"
  local CYAN="${ESC}[36m"
  local DIM="${ESC}[2m"
  local RESET="${ESC}[0m"

  trap 'printf "%s" "$SHOW_CURSOR" >&2; exit 1' INT TERM

  printf "%s" "$HIDE_CURSOR" >&2

  echo "" >&2
  echo "┌──────────────────────────────────────────────────────────────┐" >&2
  echo "│   🌟 Choose Your Starter Harnemon!                           │" >&2
  echo "│   Use [↑ / ↓] arrow keys to navigate, [Enter] to adopt.      │" >&2
  echo "└──────────────────────────────────────────────────────────────┘" >&2
  echo "" >&2

  render_starter_menu() {
    local idx=0
    for opt in "${options[@]}"; do
      local label="${opt#*:}"
      if [ "$idx" -eq "$selected" ]; then
        printf "%s❯ %s%s\n" "${CYAN}${BOLD}" "$label" "$RESET" >&2
      else
        printf "  %s%s%s\n" "$DIM" "$label" "$RESET" >&2
      fi
      idx=$((idx + 1))
    done
  }

  render_starter_menu

  while true; do
    local key=""
    IFS= read -rsn1 key < "$tty_in" || break
    if [[ "$key" == "$ESC" ]]; then
      local rest=""
      read -rsn2 -t 1 rest < "$tty_in" || rest=""
      key+="$rest"
    fi

    local move=0
    case "$key" in
      $'\033[A'|k|K) # Up
        if [ "$selected" -gt 0 ]; then
          selected=$((selected - 1))
          move=1
        fi
        ;;
      $'\033[B'|j|J) # Down
        if [ "$selected" -lt $((num_options - 1)) ]; then
          selected=$((selected + 1))
          move=1
        fi
        ;;
      "") # Enter
        break
        ;;
      1) selected=0; break ;;
      2) selected=1; break ;;
      3) selected=2; break ;;
      4) selected=3; break ;;
      0|5|e|E) selected=4; break ;;
      q|Q)
        printf "%s" "$SHOW_CURSOR" >&2
        echo "Adoption canceled." >&2
        exit 0
        ;;
    esac

    if [ "$move" -eq 1 ]; then
      printf "\033[%dA" "$num_options" >&2
      render_starter_menu
    fi
  done

  printf "%s" "$SHOW_CURSOR" >&2
  trap - INT TERM

  local chosen_val="${options[$selected]%%:*}"
  echo "$chosen_val"
}

cmd_adopt() {
  local species=""
  local target_dir="."

  if [ $# -gt 0 ]; then
    case "$1" in
      nimbleet) species="nimbleet"; shift ;;
      fortoise) species="fortoise"; shift ;;
      monkin) species="monkin"; shift ;;
      yagni) species="yagni"; shift ;;
      egg) species="egg"; shift ;;
      1) species="nimbleet"; shift ;;
      2) species="fortoise"; shift ;;
      3) species="monkin"; shift ;;
      4) species="yagni"; shift ;;
      0|5) species="egg"; shift ;;
      *)
        species="$1"
        shift
        ;;
    esac
  fi

  if [ $# -gt 0 ]; then
    target_dir="$1"
  fi

  if [ -z "$species" ]; then
    species="$(choose_starter_interactive)"
  fi

  if [ "$species" = "egg" ]; then
    cmd_incubate "$target_dir"
    return 0
  fi

  local species_name=""
  local species_type=""
  local species_desc=""

  case "$species" in
    nimbleet)
      species_name="Nimbleet"
      species_type="Electric ⚡"
      species_desc="50-token skill router, ultralight zero-dependency minimal speedster"
      ;;
    fortoise)
      species_name="Fortoise"
      species_type="Water 💧"
      species_desc="Impenetrable shell, linter config guardian, lifecycle hooks fortress"
      ;;
    monkin)
      species_name="Monkin"
      species_type="Fire 🔥"
      species_desc="The Iron Law discipline, burns away guessing with root-cause proofs"
      ;;
    yagni)
      species_name="Yagni"
      species_type="Grass 🍃"
      species_desc="Ladder of Laziness, prunes dead code, slashes complexity (-N lines)"
      ;;
    *)
      local cat_json="$GLOBAL_HOME/catalog/$species/partner.json"
      if [ -f "$cat_json" ]; then
        species_name=$(grep -o '"name": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        species_type=$(grep -o '"type": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        species_desc=$(grep -o '"description": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
      else
        species_name="$(echo "$species" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
        species_type="Custom 🌟"
        species_desc="Custom Harnemon companion"
      fi
      ;;
  esac

  echo ""
  echo "🎉 Congratulations! '$species_name [$species_type]' has been adopted as your partner!"
  echo "   Trait: $species_desc"
  echo ""

  cmd_feed "$target_dir" "$species" "$species_name" "$species_type" "$species_desc"
}

cmd_incubate() {
  local target_dir="${1:-.}"
  mkdir -p "$target_dir"
  target_dir="$(cd "$target_dir" && pwd)"

  echo ""
  echo "🥚 [Harnemon Incubator] Awakening a Blank Harnemon Egg in: $target_dir"
  echo "   🐾 Partner: Harnemon Egg 🥚 [Incubating 🌱]"
  echo "   Trait: A blank canvas absorbing your coding habits, stack conventions, and 2-correction feedback."
  echo "──────────────────────────────────────────────"

  local egg_template="$SCRIPT_DIR/templates/egg"
  if [ ! -d "$egg_template" ] && [ -d "$GLOBAL_HOME/species/egg" ]; then
    egg_template="$GLOBAL_HOME/species/egg"
  elif [ ! -d "$egg_template" ] && [ -d "$GLOBAL_HOME/templates/egg" ]; then
    egg_template="$GLOBAL_HOME/templates/egg"
  fi
  if [ ! -d "$egg_template" ]; then
    echo "❌ Error: Egg template not found at $egg_template"
    exit 1
  fi

  local harnemons_dir="$target_dir/.harnemons"
  mkdir -p "$harnemons_dir"
  local species_dir="$harnemons_dir/egg"
  rm -rf "$species_dir"
  mkdir -p "$species_dir"

  cp -R "$egg_template/"* "$species_dir/"
  memory_scaffold "$species_dir"

  sprite_write "$species_dir" "egg" "Egg 🥚" 64 2>/dev/null || true

  cat << EOF > "$harnemons_dir/partner.json"
{
  "species": "egg",
  "avatar": "egg/avatar.svg",
  "name": "Harnemon Egg",
  "type": "Incubating 🌱",
  "description": "A blank canvas absorbing developer feedback and conventions to hatch a custom species",
  "status": "incubating",
  "exp": 0,
  "hatch_readiness": "0%",
  "adopted_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  if [ -d "$target_dir/.git" ]; then
    local gitignore="$target_dir/.gitignore"
    [ ! -f "$gitignore" ] && touch "$gitignore"
    local entries=(".harnemons/" ".claude/" ".gemini/" ".agents/")
    for entry in "${entries[@]}"; do
      if ! grep -q "^${entry}" "$gitignore" 2>/dev/null; then
        echo "$entry" >> "$gitignore"
      fi
    done
  fi

  echo "🔌 Wiring AI Providers (.agents/, .claude/, .gemini/)..."
  mkdir -p "$target_dir/.agents" "$target_dir/.claude" "$target_dir/.gemini"

  rm -rf "$target_dir/.agents/skills"
  ln -sf "../.harnemons/egg/skills" "$target_dir/.agents/skills"

  rm -rf "$target_dir/.claude/skills"
  ln -sf "../.harnemons/egg/skills" "$target_dir/.claude/skills"

  generate_agents_md "$target_dir" "egg" "Harnemon Egg 🥚" "Incubating 🌱" \
    "A blank canvas absorbing developer feedback and conventions to hatch a custom species" \
    "This project is incubating a raw Harnemon Egg with the 3 Pillars (Rule, Skill, Hook)." \
    "Partner"

  sprite_write "$species_dir" "egg" "Egg 🥚" 64 2>/dev/null || true

  echo "──────────────────────────────────────────────"
  echo "✨ [Harnemon Incubator] Egg is now active!"
  sprite_show "$species_dir/sprite.json" 26 "   "
  echo "   • Start coding as usual. Whenever you correct the agent or set conventions,"
  echo "     the incubation engine will absorb it and increase Hatch Readiness."
  echo "   • When ready to hatch, run: harnemon hatch <species-name>"
}

cmd_hatch() {
  local species_name="${1:-}"
  local p_type="Custom 🌟"
  local p_desc=""
  local target_dir="."
  local force_hatch=false

  if [ -z "$species_name" ]; then
    echo "❌ Error: Please specify a species name for the hatched Harnemon."
    echo "   Usage: harnemon hatch <species-name> [--type <type>] [--desc <description>] [path]"
    exit 1
  fi
  shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --type|-t)
        p_type="$2"
        shift 2
        ;;
      --desc|-d)
        p_desc="$2"
        shift 2
        ;;
      --force|-f)
        force_hatch=true
        shift
        ;;
      *)
        target_dir="$1"
        shift
        ;;
    esac
  done

  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local egg_dir="$harnemons_dir/egg"

  if [ ! -d "$egg_dir" ]; then
    echo "❌ Error: No incubating egg found at $harnemons_dir/egg."
    echo "   To start incubating an egg first, run: harnemon incubate"
    exit 1
  fi

  local entries corrections learned_rules learned_skills readiness
  read -r entries corrections learned_rules learned_skills <<< "$(memory_counts "$egg_dir")"
  readiness=$(memory_readiness "$entries" "$learned_rules" "$learned_skills")
  if [ "$readiness" -lt "$MEMORY_HATCH_MIN" ] && [ "$force_hatch" != true ]; then
    echo "🥚 The egg is not ready to hatch yet."
    echo "──────────────────────────────────────────────"
    echo "   Hatch readiness: ${readiness}% (need ${MEMORY_HATCH_MIN}%)"
    echo "   • Evidence recorded: $entries entries ($corrections corrections)"
    echo "   • Rules learned:     $learned_rules"
    echo "   • Moves learned:     $learned_skills"
    echo "──────────────────────────────────────────────"
    echo "   An egg hatches into what it absorbed. Keep coding with it, and record"
    echo "   what it learns:  harnemon note \"<what you corrected>\""
    echo "   To hatch anyway: harnemon hatch <name> --force"
    exit 1
  fi

  local clean_species
  clean_species="$(echo "$species_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
  local display_name
  display_name="$(echo "$species_name" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"

  if [ -z "$p_desc" ]; then
    p_desc="Autonomous custom Harnemon hatched and forged in $(basename "$target_dir")"
  fi

  local target_species_dir="$harnemons_dir/$clean_species"
  if [ -d "$target_species_dir" ]; then
    echo "⚠️ Target species directory '$target_species_dir' already exists. Overwriting..."
    rm -rf "$target_species_dir"
  fi

    # Rename egg dir to species dir
  mv "$egg_dir" "$target_species_dir"
  rm -f "$target_species_dir/rules/incubation-kernel.md"

  sprite_write "$target_species_dir" "$clean_species" "$p_type" 64 2>/dev/null || true

  local kept merged
  read -r kept merged <<< "$(memory_distill "$target_species_dir" "$display_name")"

  cat << EOF > "$harnemons_dir/partner.json"
{
  "species": "$clean_species",
  "avatar": "$clean_species/avatar.svg",
  "name": "$display_name",
  "type": "$p_type",
  "description": "$p_desc",
  "status": "mature",
  "hatched_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  rm -rf "$target_dir/.agents/skills"
  ln -sf "../.harnemons/$clean_species/skills" "$target_dir/.agents/skills"

  rm -rf "$target_dir/.claude/skills"
  ln -sf "../.harnemons/$clean_species/skills" "$target_dir/.claude/skills"

  generate_agents_md "$target_dir" "$clean_species" "$display_name" "$p_type" "$p_desc" "" "Partner"

  echo ""
  echo "✨🐣 CRACK! The Harnemon Egg has hatched! 🐣✨"
  echo "──────────────────────────────────────────────"
  sprite_show "$target_species_dir/sprite.json" 32 "   "
  echo ""
  echo "🎉 Congratulations! '$display_name [$p_type]' is born!"
  echo "   Trait:   $p_desc"
  echo "   Home:    .harnemons/$clean_species/"
  echo "──────────────────────────────────────────────"
  echo "🧬 Distillation:"
  echo "   • $((kept + merged)) episodes → $kept memories$([ "$merged" -gt 0 ] && echo " ($merged duplicate$([ "$merged" -gt 1 ] && echo s) merged)")"
  echo "   • Episodes kept intact at .harnemons/$clean_species/memory/episodes/"
  echo "   • Distilled into .harnemons/$clean_species/memory/MEMORY.md"
  echo "──────────────────────────────────────────────"
  echo "📜 Active Abilities:"
  for r in "$target_species_dir/rules/"*.md; do
    [ -f "$r" ] || continue
    echo "   • $(basename "$r" .md)"
  done
  echo "🧰 Learned Moves:"
  for s in "$target_species_dir/skills/"*; do
    [ -d "$s" ] || continue
    echo "   • $(basename "$s")"
  done
  echo "──────────────────────────────────────────────"
  echo "🚀 Run 'harnemon register' to add $display_name to the global Harnedex!"
}

cmd_register() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local partner_file="$harnemons_dir/partner.json"

  if [ ! -f "$partner_file" ]; then
    echo "❌ Error: No partner.json found in $harnemons_dir."
    exit 1
  fi

  local species p_name p_type p_desc
  species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
  p_name=$(grep -o '"name": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
  p_type=$(grep -o '"type": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
  p_desc=$(grep -o '"description": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)

  if [ "$species" = "egg" ]; then
    echo "❌ Error: Cannot register an unhatched egg. Run 'harnemon hatch <name>' first!"
    exit 1
  fi

  local global_catalog="$GLOBAL_HOME/catalog/$species"
  mkdir -p "$global_catalog"
  cp -R "$harnemons_dir/$species/"* "$global_catalog/"
  cp "$partner_file" "$global_catalog/partner.json"

  echo ""
  echo "📖 [Harnedex Registry] Registered '$p_name [$p_type]' to global catalog!"
  echo "   Saved at: $global_catalog"
  echo "   All other repositories can now adopt this species with:"
  echo "   ❯ harnemon adopt $species"
}


cmd_party() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local party_file="$harnemons_dir/party.json"
  local partner_file="$harnemons_dir/partner.json"

  if [ ! -d "$harnemons_dir" ]; then
    echo "❌ Error: No Harnemon found in $target_dir. Run 'harnemon adopt' or 'harnemon incubate' first!"
    exit 1
  fi

  echo "🐾 [Harnemon Party] Team Lineup at: $target_dir"
  echo "──────────────────────────────────────────────"

  local active_species="nimbleet"
  if [ -f "$party_file" ]; then
    active_species=$(grep -o '"lead": "[^"]*' "$party_file" | head -n 1 | cut -d'"' -f4)
  elif [ -f "$partner_file" ]; then
    active_species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
  fi

  local active_partner_file="$harnemons_dir/$active_species/partner.json"
  [ ! -f "$active_partner_file" ] && active_partner_file="$partner_file"

  local p_name p_type p_desc
  p_name=$(grep -o '"name": "[^"]*' "$active_partner_file" | head -n 1 | cut -d'"' -f4 || echo "$active_species")
  p_type=$(grep -o '"type": "[^"]*' "$active_partner_file" | head -n 1 | cut -d'"' -f4 || echo "Active ⚡")
  p_desc=$(grep -o '"description": "[^"]*' "$active_partner_file" | head -n 1 | cut -d'"' -f4 || echo "")

  echo "🌟 Active Lead: $p_name [$p_type]"
  echo "   Trait: $p_desc"
  echo "   Home:  .harnemons/$active_species/"
  echo ""
  echo "👥 Party Lineup:"

  local count=0
  for sdir in "$harnemons_dir/"*; do
    [ -d "$sdir" ] || continue
    local sname
    sname="$(basename "$sdir")"
    local s_part="$sdir/partner.json"
    [ ! -f "$s_part" ] && s_part="$partner_file"
    
    local sn st
    sn=$(grep -o '"name": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "$sname")
    st=$(grep -o '"type": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "")
    
    count=$((count + 1))
    if [ "$sname" = "$active_species" ]; then
      echo "   $count. $sn [$st] ➔ (Active Lead)"
    else
      echo "   $count. $sn [$st]"
    fi
  done

  echo "──────────────────────────────────────────────"
  echo "💡 Party Actions:"
  echo "   • Switch lead:    harnemon switch <species>"
  echo "   • Recruit member: harnemon recruit <species>"
  echo "   • Dismiss member: harnemon dismiss <species>"
}

cmd_recruit() {
  local species="${1:-}"
  local target_dir="${2:-.}"

  if [ -z "$species" ]; then
    echo "❌ Error: Please specify a species to recruit (e.g. monkin, yagni, fortoise, supabird)."
    echo "   Usage: harnemon recruit <species> [path]"
    exit 1
  fi

  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"

  if [ ! -d "$harnemons_dir" ]; then
    echo "❌ Error: No Harnemon found in $target_dir. Run 'harnemon adopt' or 'harnemon incubate' first!"
    exit 1
  fi

  local species_dir="$harnemons_dir/$species"
  if [ -d "$species_dir" ]; then
    echo "ℹ️ '$species' is already a member of your project party!"
    return 0
  fi

  local species_name="" species_type="" species_desc=""
  case "$species" in
    nimbleet)
      species_name="Nimbleet"
      species_type="Electric ⚡"
      species_desc="50-token skill router, ultralight zero-dependency minimal speedster"
      ;;
    fortoise)
      species_name="Fortoise"
      species_type="Water 💧"
      species_desc="Impenetrable shell, linter config guardian, lifecycle hooks fortress"
      ;;
    monkin)
      species_name="Monkin"
      species_type="Fire 🔥"
      species_desc="The Iron Law discipline, burns away guessing with root-cause proofs"
      ;;
    yagni)
      species_name="Yagni"
      species_type="Grass 🍃"
      species_desc="Ladder of Laziness, prunes dead code, slashes complexity (-N lines)"
      ;;
    *)
      local cat_json="$GLOBAL_HOME/catalog/$species/partner.json"
      if [ -f "$cat_json" ]; then
        species_name=$(grep -o '"name": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        species_type=$(grep -o '"type": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        species_desc=$(grep -o '"description": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
      else
        species_name="$(echo "$species" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
        species_type="Custom 🌟"
        species_desc="Custom Harnemon party specialist"
      fi
      ;;
  esac

  echo "🎉 [Harnemon Party] Recruiting '$species_name [$species_type]' into project party..."

  local species_source="$SCRIPT_DIR/species/$species"
  if [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/species/$species" ]; then
    species_source="$GLOBAL_HOME/species/$species"
  elif [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/catalog/$species" ]; then
    species_source="$GLOBAL_HOME/catalog/$species"
  fi

  if [ ! -d "$species_source" ]; then
    echo "❌ Error: Unknown species '$species'. Run 'harnemon dex' to see available species."
    exit 1
  fi

  mkdir -p "$species_dir/rules" "$species_dir/skills"

  sprite_write "$species_dir" "$species" "$species_type" 64 2>/dev/null || true

  cat << EOF > "$species_dir/partner.json"
{
  "species": "$species",
  "avatar": "avatar.svg",
  "name": "$species_name",
  "type": "$species_type",
  "description": "$species_desc",
  "recruited_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  local rules_src="$species_source/rules"
  for rf in "$rules_src/"*.md; do
    [ -f "$rf" ] || continue
    local bname
    bname="$(basename "$rf")"
    cp "$rf" "$species_dir/rules/$bname"
  done

  local skills_src="$species_source/skills"
  for sd in "$skills_src/"*; do
    local sname
    sname="$(basename "$sd")"
    if [ -d "$sd" ]; then
      mkdir -p "$species_dir/skills/$sname"
      cp -R "$sd/"* "$species_dir/skills/$sname/"
    elif [ -f "$sd" ]; then
      cp "$sd" "$species_dir/skills/$sname"
    fi
  done

  local current_lead="nimbleet"
  if [ -f "$harnemons_dir/party.json" ]; then
    current_lead=$(grep -o '"lead": "[^"]*' "$harnemons_dir/party.json" | head -n 1 | cut -d'"' -f4)
  elif [ -f "$harnemons_dir/partner.json" ]; then
    current_lead=$(grep -o '"species": "[^"]*' "$harnemons_dir/partner.json" | head -n 1 | cut -d'"' -f4)
  fi

  cat << EOF > "$harnemons_dir/party.json"
{
  "lead": "$current_lead",
  "updated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  echo "✨ '$species_name [$species_type]' successfully joined the party!"
  echo "   Home: .harnemons/$species/"
  sprite_show "$species_dir/sprite.json" 28 "   "

  local l_name="Nimbleet" l_type="Electric ⚡" l_desc="50-token skill router, ultralight zero-dependency minimal speedster"
  local l_part="$harnemons_dir/$current_lead/partner.json"
  if [ -f "$l_part" ]; then
    l_name=$(grep -o '"name": "[^"]*' "$l_part" | head -n 1 | cut -d'"' -f4 || echo "$current_lead")
    l_type=$(grep -o '"type": "[^"]*' "$l_part" | head -n 1 | cut -d'"' -f4 || echo "")
    l_desc=$(grep -o '"description": "[^"]*' "$l_part" | head -n 1 | cut -d'"' -f4 || echo "")
  fi
  generate_agents_md "$target_dir" "$current_lead" "$l_name" "$l_type" "$l_desc"
}

cmd_switch() {
  local species="${1:-}"
  local target_dir="${2:-.}"

  if [ -z "$species" ]; then
    echo "❌ Error: Please specify which species to switch to as Active Lead."
    echo "   Usage: harnemon switch <species> [path]"
    exit 1
  fi

  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local species_dir="$harnemons_dir/$species"

  if [ ! -d "$species_dir" ]; then
    echo "ℹ️ '$species' is not yet in the party. Recruiting now..."
    cmd_recruit "$species" "$target_dir"
  fi

  local s_part="$harnemons_dir/partner.json"
  [ -f "$species_dir/partner.json" ] && s_part="$species_dir/partner.json"

  local p_name p_type p_desc
  p_name=$(grep -o '"name": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "$species")
  p_type=$(grep -o '"type": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "")
  p_desc=$(grep -o '"description": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "")

  cat << EOF > "$harnemons_dir/party.json"
{
  "lead": "$species",
  "switched_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  cat << EOF > "$harnemons_dir/partner.json"
{
  "species": "$species",
  "avatar": "$species/avatar.svg",
  "name": "$p_name",
  "type": "$p_type",
  "description": "$p_desc",
  "active_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  rm -rf "$target_dir/.agents/skills"
  ln -sf "../.harnemons/$species/skills" "$target_dir/.agents/skills"

  rm -rf "$target_dir/.claude/skills"
  ln -sf "../.harnemons/$species/skills" "$target_dir/.claude/skills"

  generate_agents_md "$target_dir" "$species" "$p_name" "$p_type" "$p_desc"

  echo ""
  echo "⚡ [Harnemon Party] Switched Active Lead to: '$p_name [$p_type]'!"
  echo "   All AI queries and turn messages will now be handled by $p_name."
}

cmd_dismiss() {
  local species="${1:-}"
  local target_dir="${2:-.}"

  if [ -z "$species" ]; then
    echo "❌ Error: Please specify which species to dismiss."
    echo "   Usage: harnemon dismiss <species> [path]"
    exit 1
  fi

  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local species_dir="$harnemons_dir/$species"

  if [ ! -d "$species_dir" ]; then
    echo "❌ Error: '$species' is not in this project party."
    exit 1
  fi

  local active_lead="nimbleet"
  if [ -f "$harnemons_dir/party.json" ]; then
    active_lead=$(grep -o '"lead": "[^"]*' "$harnemons_dir/party.json" | head -n 1 | cut -d'"' -f4)
  fi

  if [ "$species" = "$active_lead" ]; then
    echo "❌ Error: Cannot dismiss '$species' while it is the Active Lead. Please switch to another partner first!"
    echo "   ❯ harnemon switch <other-species>"
    exit 1
  fi

  rm -rf "$species_dir"
  echo "👋 Dismissed '$species' from project party."
}


# ── Managed markdown blocks ───────────────────────────────────────────────────
# Every wiring Harnemon writes into a markdown file is fenced by HTML comment
# markers. A regeneration replaces only the block carrying its own marker, so
# hand-written prose in the same file survives untouched, and the version stamp
# on the opening marker records which release produced the block.

md_block_write() {
  # file, block id; body arrives on stdin
  local file="$1" id="$2" body begin end tmp
  body="$(cat)"
  begin="<!-- harnemon:$id:begin v$VERSION -->"
  end="<!-- harnemon:$id:end -->"
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || : > "$file"
  # 본문은 파일로 건넨다. BSD awk는 -v 변수 안의 줄바꿈을 받지 못한다
  local bodyfile
  bodyfile="$(mktemp)"
  printf '%s\n' "$body" > "$bodyfile"
  tmp="$(mktemp)"
  awk -v id="$id" -v begin="$begin" -v end="$end" -v bodyfile="$bodyfile" '
    function emit(   line) {
      print begin
      while ((getline line < bodyfile) > 0) print line
      close(bodyfile)
      print end
    }
    index($0, "<!-- harnemon:" id ":begin") == 1 { found = 1; inblock = 1; emit(); next }
    inblock && index($0, "<!-- harnemon:" id ":end") == 1 { inblock = 0; next }
    inblock { next }
    { print; last = $0 }
    END { if (!found) { if (NR > 0 && last != "") print ""; emit() } }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
  rm -f "$bodyfile"
}

md_block_drop() {
  # file, block id — retires a block that no longer applies
  local file="$1" id="$2" tmp
  [ -f "$file" ] || return 0
  grep -q "<!-- harnemon:$id:begin" "$file" || return 0
  tmp="$(mktemp)"
  awk -v id="$id" '
    index($0, "<!-- harnemon:" id ":begin") == 1 { inblock = 1; next }
    inblock && index($0, "<!-- harnemon:" id ":end") == 1 { inblock = 0; next }
    inblock { next }
    { print }
  ' "$file" | awk 'NF || prev { print } { prev = NF }' > "$tmp"
  mv "$tmp" "$file"
}


generate_agents_md() {
  local target_dir="$1"
  local lead_species="$2"
  local p_name="$3"
  local p_type="$4"
  local p_desc="$5"
  local intro="${6:-This project is governed by an adopted Harnemon companion with the 3 Pillars (Rule, Skill, Hook).}"
  local label="${7:-Active Lead}"

  local harnemons_dir="$target_dir/.harnemons"
  local species_dir="$harnemons_dir/$lead_species"
  local agents_md="$target_dir/.agents/AGENTS.md"
  mkdir -p "$target_dir/.agents" "$target_dir/.claude" "$target_dir/.gemini"

  if [ ! -f "$agents_md" ]; then
    printf '# Harnemon Operating Rules (AGENTS.md)\n' > "$agents_md"
  fi

  md_block_write "$agents_md" "partner" << EOF
**$label**: $p_name [$p_type]
**Species**: $lead_species
**Description**: $p_desc

$intro
EOF

  local rules_body="## Active Abilities (Rules)" rule_count=0 rf bname
  for rf in "$species_dir/rules/"*.md; do
    [ -f "$rf" ] || continue
    bname="$(basename "$rf")"
    rules_body="$rules_body
@../.harnemons/$lead_species/rules/$bname"
    rule_count=$((rule_count + 1))
  done
  printf '%s\n' "$rules_body" | md_block_write "$agents_md" "rules"

  local party_body="## Party Roster & Specialists" party_count=0 sdir sname s_part sn st sd
  for sdir in "$harnemons_dir/"*; do
    [ -d "$sdir" ] || continue
    sname="$(basename "$sdir")"
    [ "$sname" = "$lead_species" ] && continue
    [ "$sname" = "egg" ] && continue
    s_part="$sdir/partner.json"
    sn="$sname"; st=""; sd=""
    if [ -f "$s_part" ]; then
      sn=$(grep -o '"name": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "$sname")
      st=$(grep -o '"type": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "")
      sd=$(grep -o '"description": "[^"]*' "$s_part" | head -n 1 | cut -d'"' -f4 || echo "")
    fi
    party_body="$party_body
- **$sn [$st]** — \`.harnemons/$sname/\` ($sd)"
    party_count=$((party_count + 1))
  done
  if [ "$party_count" -gt 0 ]; then
    printf '%s\n' "$party_body" | md_block_write "$agents_md" "party"
  else
    md_block_drop "$agents_md" "party"
  fi

  printf '## Learned Moves (Skills Catalog)\n@../.harnemons/%s/skills/INDEX.md\n' "$lead_species" \
    | md_block_write "$agents_md" "skills"

  local hooks_body="## Enforced Gates (Hooks)" hook_count=0 hk hname
  for hk in "$species_dir/hooks/"*; do
    [ -d "$hk" ] || continue
    hname="$(basename "$hk")"
    hooks_body="$hooks_body
- \`$hname\` — \`.harnemons/$lead_species/hooks/$hname/\`"
    hook_count=$((hook_count + 1))
  done
  if [ "$hook_count" -gt 0 ]; then
    printf '%s\n' "$hooks_body" | md_block_write "$agents_md" "hooks"
  else
    md_block_drop "$agents_md" "hooks"
  fi

  echo "@../.agents/AGENTS.md" > "$target_dir/.claude/CLAUDE.md"
  echo "@../.agents/AGENTS.md" > "$target_dir/.gemini/GEMINI.md"

  local summary="   🔌 Wired $rule_count rule(s) and the skills catalog into .agents/AGENTS.md"
  if [ "$hook_count" -gt 0 ]; then
    summary="$summary ($hook_count hook gate(s) listed)"
  fi
  echo "$summary"
}


cmd_release() {
  local target_dir="." force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes|--force) force=true; shift ;;
      -*) echo "❌ Unknown option: $1" >&2; exit 1 ;;
      *) target_dir="$1"; shift ;;
    esac
  done

  [ -d "$target_dir" ] || { echo "❌ Error: '$target_dir' is not a directory."; exit 1; }
  target_dir="$(cd "$target_dir" && pwd)"

  local harnemons_dir="$target_dir/.harnemons"
  if [ ! -d "$harnemons_dir" ]; then
    echo "ℹ️  No Harnemon lives in $target_dir. Nothing to release."
    return 0
  fi

  local species="egg" p_name="Harnemon"
  if [ -f "$harnemons_dir/party.json" ]; then
    species=$(grep -o '"lead": "[^"]*' "$harnemons_dir/party.json" | head -n 1 | cut -d'"' -f4 || echo "$species")
  elif [ -f "$harnemons_dir/partner.json" ]; then
    species=$(grep -o '"species": "[^"]*' "$harnemons_dir/partner.json" | head -n 1 | cut -d'"' -f4 || echo "$species")
  fi
  if [ -f "$harnemons_dir/partner.json" ]; then
    p_name=$(grep -o '"name": "[^"]*' "$harnemons_dir/partner.json" | head -n 1 | cut -d'"' -f4 || echo "$p_name")
  fi

  # 파티 전체를 지우므로 종족을 가리지 않고 실제 파일 수를 센다
  local entries=0 rules=0 skills=0 f
  for f in "$harnemons_dir"/*/rules/*.md; do
    [ -f "$f" ] || continue
    rules=$((rules + 1))
  done
  for f in "$harnemons_dir"/*/skills/*/SKILL.md; do
    [ -f "$f" ] || continue
    skills=$((skills + 1))
  done
  for f in "$harnemons_dir"/*/memory/episodes/*.md; do
    [ -f "$f" ] || continue
    entries=$((entries + $({ grep -c '^- \[' "$f" || true; } 2>/dev/null)))
  done

  echo ""
  echo "👋 [Harnemon Release] Releasing '$p_name' from: $target_dir"
  echo "──────────────────────────────────────────────"
  echo "   Deletes .harnemons/ — rules: $rules · moves: $skills · episode entries: $entries"
  echo "   Removes the harnemon marker blocks from .agents/AGENTS.md, keeping anything you wrote"
  echo "   Unlinks .agents/skills, .claude/skills, and the CLAUDE.md / GEMINI.md bridges"
  echo "   Leaves your ~/.harnemon global belt and Harnedex untouched"
  echo "──────────────────────────────────────────────"

  if [ "$force" = false ]; then
    local reply=""
    printf "   Type the species name to confirm (%s): " "$species"
    read -r reply || true
    if [ "$reply" != "$species" ]; then
      echo "❌ Aborted. Nothing was removed."
      exit 1
    fi
  fi

  # 1. 마크다운에서 하네몬이 소유한 블록만 걷어내고 사람이 쓴 문단은 남긴다
  local agents_md="$target_dir/.agents/AGENTS.md"
  if [ -f "$agents_md" ]; then
    local block
    for block in partner rules party skills hooks; do
      md_block_drop "$agents_md" "$block"
    done
    if ! grep -qv '^\(# Harnemon Operating Rules (AGENTS.md)\)\?$' "$agents_md"; then
      rm -f "$agents_md"
      echo "   🗑️  Removed .agents/AGENTS.md (nothing but Harnemon wiring was left)"
    else
      echo "   ✂️  Unwired the harnemon blocks from .agents/AGENTS.md"
    fi
  fi

  # 2. 하네몬이 건 심링크와 다리 파일만 정리한다
  local link
  for link in "$target_dir/.agents/skills" "$target_dir/.claude/skills"; do
    if [ -L "$link" ] && case "$(readlink "$link")" in *.harnemons/*) true ;; *) false ;; esac; then
      rm -f "$link"
      echo "   🔗 Unlinked ${link#$target_dir/}"
    fi
  done

  local bridge
  for bridge in "$target_dir/.claude/CLAUDE.md" "$target_dir/.gemini/GEMINI.md"; do
    if [ -f "$bridge" ] && [ "$(cat "$bridge")" = "@../.agents/AGENTS.md" ]; then
      rm -f "$bridge"
      echo "   🗑️  Removed ${bridge#$target_dir/}"
    fi
  done

  # 3. 하네몬이 설치한 것과 바이트가 같은 git 훅만 되돌린다
  local hk hname installed
  for hk in "$harnemons_dir"/*/hooks/*; do
    [ -d "$hk" ] || continue
    hname="$(basename "$hk")"
    installed="$target_dir/.git/hooks/$hname"
    [ -f "$installed" ] || continue
    if [ -f "$hk/$hname" ] && cmp -s "$installed" "$hk/$hname"; then
      rm -f "$installed"
      echo "   🪝 Removed .git/hooks/$hname"
    else
      echo "   ⚠️  Kept .git/hooks/$hname — it no longer matches the one Harnemon installed"
    fi
  done

  # 4. .gitignore에서는 하네몬만의 것이 확실한 줄만 걷어낸다
  local gitignore="$target_dir/.gitignore"
  if [ -f "$gitignore" ] && grep -q '^\.harnemons/$' "$gitignore"; then
    local tmp_gi
    tmp_gi="$(mktemp)"
    grep -v -e '^\.harnemons/$' -e '^# Harnemon Personal Companion$' "$gitignore" \
      | awk 'NF || prev { print } { prev = NF }' > "$tmp_gi"
    mv "$tmp_gi" "$gitignore"
    echo "   ✂️  Removed the .harnemons/ entry from .gitignore"
    if grep -qE '^\.(claude|gemini|agents)/$' "$gitignore"; then
      echo "   ℹ️  Left .claude/, .gemini/, .agents/ in .gitignore — they are not Harnemon's alone"
    fi
  fi

  rm -rf "$harnemons_dir"
  echo "   🗑️  Removed .harnemons/"

  local dir
  for dir in "$target_dir/.agents" "$target_dir/.claude" "$target_dir/.gemini"; do
    rmdir "$dir" 2>/dev/null || true
  done

  echo "──────────────────────────────────────────────"
  echo "✨ '$p_name' has been released back into the wild."
  echo "   Adopt a new partner any time: harnemon adopt   ·   harnemon incubate"
}

cmd_setup() {
  echo "⚡ [Harnemon Global Setup] Setting up Global Belt and Agent Awareness..."
  echo "──────────────────────────────────────────────"

  # 1. Symlink binary to PATH safely
  local bin_src="$SCRIPT_DIR/bin/harnemon"
  [ ! -f "$bin_src" ] && [ -f "$GLOBAL_HOME/bin/harnemon" ] && bin_src="$GLOBAL_HOME/bin/harnemon"
  local target_bin_dir="${HOME}/.local/bin"
  mkdir -p "$target_bin_dir"
  rm -f "$target_bin_dir/harnemon"
  ln -sf "$bin_src" "$target_bin_dir/harnemon"
  echo "✅ Linked CLI: $target_bin_dir/harnemon"

  # 2. Register Global Harnemon Awareness in ~/.agents/AGENTS.md
  local global_agents_dir="${HOME}/.agents"
  mkdir -p "$global_agents_dir"
  local global_agents_md="$global_agents_dir/AGENTS.md"

  # 이름공간 없는 옛 표식과 표식이 없던 시절의 블록은 한 번만 걷어낸다
  if [ -f "$global_agents_md" ] && ! grep -q "<!-- harnemon:awareness:begin" "$global_agents_md"; then
    local tmp
    tmp="$(mktemp)"
    awk '
      /<!-- harnemon:begin -->/ { skip = 1; next }
      /<!-- harnemon:end -->/   { skip = 0; next }
      skip { next }
      /^## .*Harnemon Companion/ { legacy = 1; next }
      legacy && /^#/            { legacy = 0 }
      legacy { next }
      /^#+ *#? *Global Agent Guidelines \(~\/\.agents\/AGENTS\.md\)$/ { next }
      { print }
    ' "$global_agents_md" | awk 'NF || prev { print } { prev = NF }' > "$tmp"
    mv "$tmp" "$global_agents_md"
  fi

  md_block_write "$global_agents_md" "awareness" << 'AWARENESS'
## ⚡ Harnemon Companion (~/.harnemon)
Autonomous zero-dependency harness companion for AI coding agents.

- **Adopted Workspace**: If `.harnemons/` exists, follow the active partner declared in `.agents/AGENTS.md`.
- **Unadopted Workspace**: Run `harnemon adopt` or `harnemon incubate` to awaken a companion.
- **Reference**: Full details and species catalog at `~/.harnemon/README.md`.
AWARENESS
  echo "✅ Refreshed Global Harnemon Awareness in: $global_agents_md"

  # 3. Claude Code global link if ~/.claude exists
  if [ -d "${HOME}/.claude" ]; then
    local claude_global="${HOME}/.claude/CLAUDE.md"
    if [ ! -f "$claude_global" ]; then
      echo "@../.agents/AGENTS.md" > "$claude_global"
      echo "✅ Wired global Claude Code: $claude_global -> ~/.agents/AGENTS.md"
    fi
  fi

  echo "──────────────────────────────────────────────"
  echo "✨ Global Harnemon Belt successfully initialized!"
  echo "   All AI agents across all repositories are now Harnemon-aware."
}


cmd_update() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "⚡ [Harnemon Update] Updating Harnemon Global Belt and Project Partner..."
  echo "──────────────────────────────────────────────"

  # 1. Update Global Belt from git remote if applicable
  local repo_dir="$SCRIPT_DIR"
  if [ -d "$GLOBAL_HOME/.git" ]; then
    repo_dir="$GLOBAL_HOME"
  fi

  if [ -d "$repo_dir/.git" ]; then
    echo "📦 Checking latest changes in $repo_dir..."
    git -C "$repo_dir" pull --ff-only origin main 2>/dev/null || echo "ℹ️ Git pull skipped."
  fi

  # 2. Refresh Global Agent Awareness & PATH via cmd_setup
  cmd_setup >/dev/null 2>&1 || true
  echo "✅ Refreshed Global Agent Awareness in: ${HOME}/.agents/AGENTS.md"

  # 3. Update current project instance if present
  local harnemons_dir="$target_dir/.harnemons"
  if [ -d "$harnemons_dir" ]; then
    echo "🔄 Syncing project partner in $target_dir..."
    local party_file="$harnemons_dir/party.json"
    local partner_file="$harnemons_dir/partner.json"
    local active_species="nimbleet"

    if [ -f "$party_file" ]; then
      active_species=$(grep -o '"lead": "[^"]*' "$party_file" | head -n 1 | cut -d'"' -f4)
    elif [ -f "$partner_file" ]; then
      active_species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    fi

    for sdir in "$harnemons_dir/"*; do
      [ -d "$sdir" ] || continue
      local sname
      sname="$(basename "$sdir")"
      local species_source="$SCRIPT_DIR/species/$sname"
      [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/species/$sname" ] && species_source="$GLOBAL_HOME/species/$sname"
      [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/catalog/$sname" ] && species_source="$GLOBAL_HOME/catalog/$sname"

      if [ -d "$species_source/rules" ]; then
        for rf in "$species_source/rules/"*.md; do
          [ -f "$rf" ] || continue
          local bname
          bname="$(basename "$rf")"
          cp "$rf" "$sdir/rules/$bname"
        done
      fi
    done

    local p_part="$harnemons_dir/$active_species/partner.json"
    [ ! -f "$p_part" ] && p_part="$partner_file"
    local pn="Nimbleet" pt="Electric ⚡" pd="50-token skill router"
    if [ -f "$p_part" ]; then
      pn=$(grep -o '"name": "[^"]*' "$p_part" | head -n 1 | cut -d'"' -f4 || echo "$active_species")
      pt=$(grep -o '"type": "[^"]*' "$p_part" | head -n 1 | cut -d'"' -f4 || echo "")
      pd=$(grep -o '"description": "[^"]*' "$p_part" | head -n 1 | cut -d'"' -f4 || echo "")
    fi
    generate_agents_md "$target_dir" "$active_species" "$pn" "$pt" "$pd"
    echo "✅ Synchronized project rules and wiring (.agents/AGENTS.md)"
  fi

  echo "──────────────────────────────────────────────"
  echo "✨ Harnemon update complete (v$VERSION)!"
}


cmd_version() {
  local is_short=false
  local do_check=true

  while [ $# -gt 0 ]; do
    case "$1" in
      --short|-s) is_short=true; shift ;;
      --no-check) do_check=false; shift ;;
      --check|-c) do_check=true; shift ;;
      *) shift ;;
    esac
  done

  if [ "$is_short" = true ]; then
    echo "$VERSION"
    return 0
  fi

  echo "⚡ Harnemon v$VERSION"

  if [ "$do_check" = true ]; then
    local latest_tag=""
    # 1. Check raw remote main branch version (immediate & zero-dep)
    if command -v curl >/dev/null 2>&1; then
      latest_tag=$(curl -s --connect-timeout 2 https://raw.githubusercontent.com/2JIHAN/harnemon/main/bin/harnemon 2>/dev/null | grep '^VERSION=' | head -n 1 | cut -d'"' -f2 || true)
    fi

    # 2. Check remote tags if raw lookup empty
    if [ -z "$latest_tag" ] && command -v git >/dev/null 2>&1; then
      latest_tag=$(git ls-remote --tags --refs https://github.com/2JIHAN/harnemon.git 2>/dev/null | tail -n 1 | awk -F/ '{print $NF}' || true)
    fi

    if [ -n "$latest_tag" ]; then
      local clean_latest="${latest_tag#v}"
      local clean_curr="${VERSION#v}"

      if [ "$clean_latest" != "$clean_curr" ]; then
        echo "🔔 Update available: v$clean_latest (Current: v$clean_curr)"
        echo "   Run 'harnemon update' to upgrade to the latest version!"
      else
        echo "✅ Up to date! (Latest: v$clean_latest)"
      fi
    fi
  fi
}

# ── Sprite Engine ─────────────────────────────────────────────
# Zero-dependency pixel-art renderer. Traits are derived from the species
# name, so the same name always yields the same creature.

sprite_traits() {
  # species type -> "body eyes crest hue accent ghost" (accent "-" means auto)
  awk -v S="$1" -v T="$2" 'BEGIN {
    for (i = 32; i < 127; i++) ord[sprintf("%c", i)] = i
    h = 5381
    n = length(S)
    for (i = 1; i <= n; i++) { c = substr(S, i, 1); v = ord[c]; if (v == "") v = 95; h = (h * 33 + v) % 2147483647 }
    split("round tall blocky teardrop", BD, " ")
    split("dot happy sparkle sharp", EY, " ")
    split("none antenna horn leaf ears", CR, " ")
    t = tolower(T); ghost = 0; acc = "-"
    if (S == "egg" || index(t, "egg"))                      { base = 36;  acc = "#E9C46A" }
    else if (index(t, "electric") || index(T, "\342\232\241"))   { base = 48;  acc = "#E9A400" }
    else if (index(t, "fire") || index(T, "\360\237\224\245"))  { base = 16;  acc = "#DD5540" }
    else if (index(t, "grass") || index(T, "\360\237\215\203")) { base = 104; acc = "#3E9C5C" }
    else if (index(t, "water") || index(T, "\360\237\222\247")) { base = 208; acc = "#2E86C8" }
    else if (index(t, "steel") || index(t, "iron"))         { base = 214; acc = "#7286A0" }
    else if (index(t, "ghost") || index(T, "\360\237\221\273")) { base = 276; acc = "#8A63C7"; ghost = 1 }
    else base = int(h / 256) % 360
    hue = (base + int(h / 64) % 21 - 10 + 360) % 360
    printf "%s %s %s %d %s %d\n", BD[int(h) % 4 + 1], EY[int(h / 4) % 4 + 1], CR[int(h / 16) % 5 + 1], hue, acc, ghost
  }'
}

sprite_generate() {
  # size hue body eyes crest ghost accent egg -> sprite.json on stdout
  awk -v N="$1" -v HUE="$2" -v BODY="$3" -v EYES="$4" -v CREST="$5" -v GHOST="$6" -v ACCENT="$7" -v EGG="${8:-0}" '
function mx(a, b) { return a > b ? a : b }
function rnd(v) { return int(v + 0.5) }
function fch(n, h, a, l,   k, m) {
  k = n + h / 30; k = k - 12 * int(k / 12)
  m = k - 3; if (9 - k < m) m = 9 - k
  if (m > 1) m = 1; if (m < -1) m = -1
  return l - a * m
}
function hsl(h, s, l,   a) {
  h = h % 360; if (h < 0) h += 360
  s = s / 100; l = l / 100
  a = s * (l < 1 - l ? l : 1 - l)
  return sprintf("#%02x%02x%02x", rnd(fch(0,h,a,l)*255), rnd(fch(8,h,a,l)*255), rnd(fch(4,h,a,l)*255))
}
function setp(x, y, c) { if (x >= 0 && x < N && y >= 0 && y < N) g[y "," x] = c }
function getp(x, y) { return (x >= 0 && x < N && y >= 0 && y < N) ? g[y "," x] : "" }
function ell(cx, cy, rx, ry, c,   x, y, dx, dy) {
  for (y = 0; y < N; y++) for (x = 0; x < N; x++) {
    dx = ((x + 0.5) / N - cx) / rx; dy = ((y + 0.5) / N - cy) / ry
    if (dx * dx + dy * dy <= 1) setp(x, y, c)
  }
}
function bx(x0, y0, x1, y1, c,   x, y) {
  for (y = rnd(y0 * N); y < rnd(y1 * N); y++) for (x = rnd(x0 * N); x < rnd(x1 * N); x++) setp(x, y, c)
}
function blob(nx, ny, w, h, c,   x, y, x0, y0) {
  x0 = rnd(nx * N - w / 2); y0 = rnd(ny * N - h / 2)
  for (y = y0; y < y0 + h; y++) for (x = x0; x < x0 + w; x++) setp(x, y, c)
}
function unit(k) { return mx(1, rnd(U * k)) }
BEGIN {
  split("0.50 0.59 0.33 0.28 0.31 0.55 0.87", F1, " ")
  split("0.50 0.58 0.27 0.33 0.25 0.53 0.91", F2, " ")
  split("0.50 0.58 0.32 0.29 0.29 0.54 0.87", F3, " ")
  split("0.50 0.63 0.31 0.25 0.30 0.60 0.88", F4, " ")
  if (BODY == "round")       { for (i=1;i<=7;i++) B[i] = F1[i] }
  else if (BODY == "tall")   { for (i=1;i<=7;i++) B[i] = F2[i] }
  else if (BODY == "blocky") { for (i=1;i<=7;i++) B[i] = F3[i] }
  else                       { for (i=1;i<=7;i++) B[i] = F4[i] }
  CX = B[1]; CY = B[2]; RX = B[3]; RY = B[4]; TOP = B[5]; FACE = B[6]; BOT = B[7]
  U = mx(1, rnd(N / 16))

  PAL["a"] = hsl(HUE, 46, 20)
  PAL["b"] = hsl(HUE, 68, 63)
  PAL["c"] = hsl(HUE, 62, 50)
  PAL["d"] = hsl(HUE, 74, 88)
  PAL["f"] = (ACCENT != "" && ACCENT != "-") ? ACCENT : hsl(HUE + 150, 70, 55)
  PAL["g"] = "#ffffff"
  PAL["h"] = hsl(HUE + 330, 78, 72)

  if (EGG == 1) {
    ell(0.50, 0.63, 0.30, 0.27, "b")
    ell(0.50, 0.43, 0.175, 0.20, "b")
    for (y = 0; y < N; y++) for (x = 0; x < N; x++)
      if (g[y "," x] == "b" && (y + 0.5) / N > 0.70) g[y "," x] = "c"
    ell(0.40, 0.44, 0.085, 0.105, "d")
    blob(0.36, 0.66, unit(2.2), unit(1.4), "c")
    blob(0.62, 0.58, unit(1.6), unit(1.0), "c")
    blob(0.56, 0.78, unit(1.9), unit(1.2), "c")
  } else {
    if (BODY == "blocky") {
      bx(CX - RX, TOP, CX + RX, BOT, "b")
      for (k = 0; k < U; k++) for (j = 0; j < U - k; j++) {
        x0 = rnd((CX - RX) * N) + j; x1 = rnd((CX + RX) * N) - 1 - j
        y0 = rnd(TOP * N) + k;       y1 = rnd(BOT * N) - 1 - k
        delete g[y0 "," x0]; delete g[y0 "," x1]; delete g[y1 "," x0]; delete g[y1 "," x1]
      }
    } else {
      ell(CX, CY, RX, RY, "b")
      if (BODY == "teardrop") ell(CX, TOP + 0.10, RX * 0.46, 0.15, "b")
    }

    ARM = RX + 0.012
    blob(CX - ARM, FACE + 0.14, unit(0.9), unit(2.1), "c")
    blob(CX + ARM, FACE + 0.14, unit(0.9), unit(2.1), "c")

    if (GHOST == 1) {
      xa = rnd((CX - RX * 0.9) * N); xb = rnd((CX + RX * 0.9) * N)
      for (x = xa; x < xb; x++) if (int((x - xa) / U) % 2 == 0) bx(x / N, BOT - 0.02, (x + 1) / N, BOT + 0.02, "c")
    } else {
      bx(CX - RX * 0.68, BOT - 0.03, CX - RX * 0.16, BOT + 0.035, "c")
      bx(CX + RX * 0.16, BOT - 0.03, CX + RX * 0.68, BOT + 0.035, "c")
    }

    for (y = 0; y < N; y++) for (x = 0; x < N; x++)
      if (g[y "," x] == "b" && (y + 0.5) / N > CY + RY * 0.42) g[y "," x] = "c"
    ell(CX, CY + RY * 0.34, RX * 0.52, RY * 0.36, "d")

    if (CREST == "antenna") {
      len = rnd(N * 0.10)
      for (k = 1; k <= len; k++) setp(rnd(CX * N), rnd(TOP * N) - k, "a")
      blob(CX, TOP - (len + unit(0.9)) / N, unit(1.6), unit(1.6), "f")
    } else if (CREST == "horn") {
      crows = rnd(N * 0.09)
      for (k = 0; k < crows; k++) blob(CX, TOP - (crows - k - 0.5) / N, mx(1, rnd((k + 1) * U * 0.55)), 1, "f")
    } else if (CREST == "leaf") {
      len = rnd(N * 0.06)
      for (k = 1; k <= len; k++) setp(rnd(CX * N), rnd(TOP * N) - k, "a")
      ell(CX - RX * 0.30, TOP - 0.09, 0.075, 0.042, "f")
      ell(CX + RX * 0.34, TOP - 0.11, 0.065, 0.038, "f")
    } else if (CREST == "ears") {
      crows = rnd(N * 0.10)
      for (k = 0; k < crows; k++) {
        ew = mx(1, rnd((k + 1) * U * 0.55))
        blob(CX - RX * 0.60, TOP + 0.015 - (crows - k - 0.5) / N, ew, 1, "c")
        blob(CX + RX * 0.60, TOP + 0.015 - (crows - k - 0.5) / N, ew, 1, "c")
      }
    }

    EX = RX * 0.46; EY = FACE; EW = unit(1.5); EH = unit(1.7); HI = unit(0.6)
    L = CX - EX; R = CX + EX
    if (EYES == "happy") {
      blob(L - EX*0.34, EY+0.018, unit(0.8), unit(0.6), "a"); blob(L, EY-0.018, unit(0.8), unit(0.6), "a"); blob(L + EX*0.34, EY+0.018, unit(0.8), unit(0.6), "a")
      blob(R - EX*0.34, EY+0.018, unit(0.8), unit(0.6), "a"); blob(R, EY-0.018, unit(0.8), unit(0.6), "a"); blob(R + EX*0.34, EY+0.018, unit(0.8), unit(0.6), "a")
    } else if (EYES == "sharp") {
      blob(L, EY+0.012, EW, unit(1.2), "a"); blob(L - EX*0.30, EY-0.030, EW, unit(0.7), "a")
      blob(R, EY+0.012, EW, unit(1.2), "a"); blob(R + EX*0.30, EY-0.030, EW, unit(0.7), "a")
    } else if (EYES == "sparkle") {
      blob(L, EY, EW, rnd(EH*1.3), "a"); blob(L - EX*0.22, EY-0.028, HI, HI, "g"); blob(L + EX*0.20, EY+0.030, mx(1,HI-1), mx(1,HI-1), "g")
      blob(R, EY, EW, rnd(EH*1.3), "a"); blob(R - EX*0.22, EY-0.028, HI, HI, "g"); blob(R + EX*0.20, EY+0.030, mx(1,HI-1), mx(1,HI-1), "g")
    } else {
      blob(L, EY, EW, EH, "a"); blob(L - EX*0.22, EY-0.022, HI, HI, "g")
      blob(R, EY, EW, EH, "a"); blob(R - EX*0.22, EY-0.022, HI, HI, "g")
    }

    blob(CX - RX*0.70, EY+0.055, unit(1.4), unit(0.6), "h")
    blob(CX + RX*0.70, EY+0.055, unit(1.4), unit(0.6), "h")
    blob(CX, EY+0.085, unit(1.2), unit(0.5), "a")
  }

  n = 0
  for (y = 0; y < N; y++) for (x = 0; x < N; x++)
    if (g[y "," x] == "" && (getp(x-1,y) != "" || getp(x+1,y) != "" || getp(x,y-1) != "" || getp(x,y+1) != "")) add[n++] = y "," x
  for (i = 0; i < n; i++) g[add[i]] = "a"

  printf "{\n"
  printf "  \"size\": %d,\n  \"hue\": %d,\n  \"body\": \"%s\",\n  \"eyes\": \"%s\",\n  \"crest\": \"%s\",\n", N, HUE, (EGG == 1 ? "egg" : BODY), (EGG == 1 ? "none" : EYES), (EGG == 1 ? "none" : CREST)
  for (y = 0; y < N; y++) { row = ""; for (x = 0; x < N; x++) { c = g[y "," x]; if (c == "") c = "."; else used[c] = 1; row = row c } rows[y] = row }
  printf "  \"palette\": {"
  first = 1; split("a b c d f g h", ORDER, " ")
  for (i = 1; i <= 7; i++) if (used[ORDER[i]]) { printf "%s \"%s\": \"%s\"", (first ? "" : ","), ORDER[i], PAL[ORDER[i]]; first = 0 }
  printf " },\n  \"rows\": [\n"
  for (y = 0; y < N; y++) printf "    \"%s\"%s\n", rows[y], (y < N - 1 ? "," : "")
  printf "  ]\n}\n"
}'
}

sprite_render() {
  # sprite.json mode(svg|ansi) [scale-or-maxwidth] [indent]
  awk -v MODE="${2:-ansi}" -v ARG="${3:-0}" -v PAD="${4:-}" -v MONO="${NO_COLOR:+1}" '
function hx(s,   i) { i = index("0123456789abcdef", tolower(s)); return i - 1 }
function ch(c, k) { return hx(substr(col[c], k, 1)) * 16 + hx(substr(col[c], k + 1, 1)) }
function lum(c) { return (0.299 * ch(c,2) + 0.587 * ch(c,4) + 0.114 * ch(c,6)) / 255 }
{ all = all $0 " " }
END {
  if (match(all, /"size"[ ]*:[ ]*[0-9]+/)) { seg = substr(all, RSTART, RLENGTH); sub(/.*:[ ]*/, "", seg); N = seg + 0 }
  s = all
  while (match(s, /"[a-z]"[ ]*:[ ]*"#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]"/)) {
    seg = substr(s, RSTART, RLENGTH); col[substr(seg, 2, 1)] = substr(seg, index(seg, "#"), 7)
    s = substr(s, RSTART + RLENGTH)
  }
  s = all; nr = 0
  while (match(s, /"[a-z.]+"/)) {
    seg = substr(s, RSTART + 1, RLENGTH - 2)
    if (length(seg) == N) rows[nr++] = seg
    s = substr(s, RSTART + RLENGTH)
  }
  if (N == 0 || nr == 0) { exit 3 }

  if (MODE == "svg") {
    sc = (ARG > 0 ? ARG : 8)
    printf "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"%d\" height=\"%d\" viewBox=\"0 0 %d %d\" shape-rendering=\"crispEdges\">\n", N*sc, N*sc, N, N
    for (y = 0; y < nr; y++) {
      r = rows[y]; x = 0
      while (x < N) {
        c = substr(r, x + 1, 1)
        if (c == ".") { x++; continue }
        run = 1
        while (x + run < N && substr(r, x + run + 1, 1) == c) run++
        printf "  <rect x=\"%d\" y=\"%d\" width=\"%d\" height=\"1\" fill=\"%s\"/>\n", x, y, run, col[c]
        x += run
      }
    }
    printf "</svg>\n"
    exit 0
  }

  maxw = (ARG > 0 ? ARG : 0)
  step = 1
  if (maxw > 0 && N > maxw) step = int((N + maxw - 1) / maxw)
  esc = sprintf("%c", 27)
  RAMP[1] = "\342\226\221"; RAMP[2] = "\342\226\222"; RAMP[3] = "\342\226\223"; RAMP[4] = "\342\226\210"
  for (y = 0; y < nr; y += 2 * step) {
    line = ""
    for (x = 0; x < N; x += step) {
      t = substr(rows[y], x + 1, 1)
      b = (y + step < nr) ? substr(rows[y + step], x + 1, 1) : "."
      if (t == "." && b == ".") { line = line " "; continue }
      if (MONO == "1") {
        c = (t != "." ? t : b)
        v = lum(c); i = int((1 - v) * 3) + 1; if (i > 4) i = 4; if (i < 1) i = 1
        line = line RAMP[i]
        continue
      }
      if (t != "." && b != ".")
        line = line esc "[38;2;" ch(t,2) ";" ch(t,4) ";" ch(t,6) "m" esc "[48;2;" ch(b,2) ";" ch(b,4) ";" ch(b,6) "m\342\226\200" esc "[0m"
      else if (t != ".")
        line = line esc "[38;2;" ch(t,2) ";" ch(t,4) ";" ch(t,6) "m\342\226\200" esc "[0m"
      else
        line = line esc "[38;2;" ch(b,2) ";" ch(b,4) ";" ch(b,6) "m\342\226\204" esc "[0m"
    }
    sub(/[ ]+$/, "", line)
    if (line != "") print PAD line
  }
}' "$1"
}

sprite_write() {
  # species_dir species type [size] — writes sprite.json and avatar.svg
  local dir="$1" species="$2" ptype="${3:-}" size="${4:-64}"
  local body eyes crest hue accent ghost egg=0
  [ "$species" = "egg" ] && egg=1
  read -r body eyes crest hue accent ghost <<< "$(sprite_traits "$species" "$ptype")"
  mkdir -p "$dir"
  sprite_generate "$size" "$hue" "$body" "$eyes" "$crest" "$ghost" "$accent" "$egg" > "$dir/sprite.json"
  sprite_render "$dir/sprite.json" svg 8 > "$dir/avatar.svg"
}

sprite_show() {
  # sprite.json [maxwidth] [indent] — prints the creature, silent when absent
  [ -f "$1" ] || return 0
  sprite_render "$1" ansi "${2:-32}" "${3:-   }" 2>/dev/null || true
}

cmd_draw() {
  local target_dir="." species="" size=64 import_file="" force=false quiet=false egg=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --size|-s) size="$2"; shift 2 ;;
      --import|-i) import_file="$2"; shift 2 ;;
      --egg) egg=true; shift ;;
      --force|-f) force=true; shift ;;
      --quiet|-q) quiet=true; shift ;;
      --dir|-C) target_dir="$2"; shift 2 ;;
      -*) echo "❌ Unknown option: $1"; exit 1 ;;
      *)
        if [ -d "$1" ]; then target_dir="$1"; else species="$1"; fi
        shift
        ;;
    esac
  done

  case "$size" in
    16|24|32|64) ;;
    *) echo "❌ Error: --size must be one of 16, 24, 32, 64 (got '$size')."; exit 1 ;;
  esac

  target_dir="$(cd "$target_dir" && pwd)"
  local harnemons_dir="$target_dir/.harnemons"
  local partner_file="$harnemons_dir/partner.json"

  if [ "$egg" = true ]; then
    species="egg"
  elif [ -z "$species" ]; then
    if [ -f "$partner_file" ]; then
      species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    fi
    if [ -z "$species" ]; then
      echo "❌ Error: No Harnemon found at $harnemons_dir."
      echo "   Run 'harnemon adopt' or pass a species name: harnemon draw <species>"
      exit 1
    fi
  fi

  local species_dir="$harnemons_dir/$species"
  if [ ! -d "$species_dir" ]; then
    echo "❌ Error: No species directory at .harnemons/$species/."
    exit 1
  fi

  local p_type="Custom 🌟"
  if [ -f "$partner_file" ]; then
    p_type=$(grep -o '"type": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4 || echo "Custom 🌟")
  fi

  if [ -n "$import_file" ]; then
    if [ ! -f "$import_file" ]; then
      echo "❌ Error: Cannot read '$import_file'."
      exit 1
    fi
    if ! sprite_render "$import_file" svg 8 > "$species_dir/avatar.svg" 2>/dev/null; then
      echo "❌ Error: '$import_file' has no usable sprite (missing size, palette, or rows)."
      rm -f "$species_dir/avatar.svg"
      exit 1
    fi
    cp "$import_file" "$species_dir/sprite.json"
    echo "📥 Imported sprite from $import_file"
  elif [ ! -f "$species_dir/sprite.json" ] || [ "$force" = true ]; then
    sprite_write "$species_dir" "$species" "$p_type" "$size"
  else
    if ! sprite_render "$species_dir/sprite.json" svg 8 > "$species_dir/avatar.svg" 2>/dev/null; then
      echo "❌ Error: .harnemons/$species/sprite.json is unreadable. Redraw it with: harnemon draw --force"
      exit 1
    fi
  fi

  if [ -f "$partner_file" ] && ! grep -q '"avatar"' "$partner_file"; then
    sprite_link_partner "$partner_file" "$species"
  fi

  if [ "$quiet" != true ]; then
    echo ""
    sprite_show "$species_dir/sprite.json" 32 "   "
    echo ""
    echo "🎨 .harnemons/$species/sprite.json  →  .harnemons/$species/avatar.svg"
  fi
}

sprite_link_partner() {
  # partner.json species — adds the avatar pointer without disturbing other keys
  local file="$1" species="$2" tmp
  tmp="$(mktemp)"
  awk -v path="$species/avatar.svg" '
    /"species"[ ]*:/ && !done { print; printf "  \"avatar\": \"%s\",\n", path; done = 1; next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# ── Memory Engine ─────────────────────────────────────────────
# Episodes are append-only and never rewritten. MEMORY.md is the distilled
# layer, written once at hatch and tended afterwards by harnemon rest.

MEMORY_HATCH_MIN=60
MEMORY_BASE_RULES=" incubation-kernel harness-evolution "
MEMORY_BASE_SKILLS=" harness-evolution "

memory_species_dir() {
  # target_dir -> path of the active species directory, empty when there is none
  local td="$1" hd="$1/.harnemons" sp=""
  if [ -f "$hd/partner.json" ]; then
    sp=$(grep -o '"species": "[^"]*' "$hd/partner.json" | head -n 1 | cut -d'"' -f4 || true)
  fi
  [ -z "$sp" ] && [ -d "$hd/egg" ] && sp="egg"
  [ -n "$sp" ] && [ -d "$hd/$sp" ] && echo "$hd/$sp"
}

memory_episode_file() {
  # species_dir -> path of today's episode file, created when absent
  local dir="$1/memory/episodes"
  local file="$dir/$(date -u +%Y-%m-%d).md"
  mkdir -p "$dir"
  if [ ! -f "$file" ]; then
    printf '# Episodes · %s\n\n<!-- Append only. Never rewrite a past entry. -->\n\n' "$(date -u +%Y-%m-%d)" > "$file"
  fi
  echo "$file"
}

memory_scaffold() {
  # species_dir -> ensures the episode ledger exists, egg or mature alike
  local dir="$1/memory" src
  mkdir -p "$dir/episodes"
  if [ ! -f "$dir/README.md" ]; then
    for src in "$SCRIPT_DIR/templates/egg/memory/README.md" "$GLOBAL_HOME/templates/egg/memory/README.md"; do
      [ -f "$src" ] && { cp "$src" "$dir/README.md"; break; }
    done
  fi
}

memory_incubating() {
  # species_dir -> 0 when this Harnemon is still an egg
  [ "$(basename "$1")" = "egg" ]
}

memory_counts() {
  # species_dir -> "entries corrections rules skills"
  local dir="$1" entries=0 corrections=0 rules=0 skills=0 f b
  if [ -d "$dir/memory/episodes" ]; then
    for f in "$dir/memory/episodes/"*.md; do
      [ -f "$f" ] || continue
      entries=$((entries + $({ grep -c '^- \[' "$f" || true; } 2>/dev/null)))
      corrections=$((corrections + $({ grep -c '^- \[correction\]' "$f" || true; } 2>/dev/null)))
    done
  fi
  for f in "$dir/rules/"*.md; do
    [ -f "$f" ] || continue
    b="$(basename "$f" .md)"
    case "$MEMORY_BASE_RULES" in *" $b "*) ;; *) rules=$((rules + 1)) ;; esac
  done
  for f in "$dir/skills/"*; do
    [ -d "$f" ] || continue
    b="$(basename "$f")"
    case "$MEMORY_BASE_SKILLS" in *" $b "*) ;; *) skills=$((skills + 1)) ;; esac
  done
  echo "$entries $corrections $rules $skills"
}

memory_readiness() {
  # entries rules skills -> hatch readiness percentage
  # Evidence alone cannot hatch an egg: promotions into rules and skills carry
  # most of the weight, because those are what a mature species is made of.
  local e="$1" r="$2" s="$3" a b c
  a=$(( e * 8 ));  [ "$a" -gt 40 ] && a=40
  b=$(( r * 20 )); [ "$b" -gt 40 ] && b=40
  c=$(( s * 20 )); [ "$c" -gt 20 ] && c=20
  echo $(( a + b + c ))
}

memory_exp() {
  # entries rules skills -> experience points
  echo $(( $1 * 10 + $2 * 50 + $3 * 30 ))
}

memory_distill() {
  # species_dir display_name -> writes memory/MEMORY.md, echoes "kept merged"
  local dir="$1" name="$2"
  local out="$dir/memory/MEMORY.md"
  mkdir -p "$dir/memory"

  local files=("$dir/memory/episodes/"*.md)
  [ -e "${files[0]}" ] || { printf '0 0\n'; return 0; }

  awk -v NAME="$name" -v TODAY="$(date -u +%Y-%m-%d)" '
    FNR == 1 { src = FILENAME; sub(/.*\/episodes\//, "episodes/", src) }
    /^- \[/ {
      t = substr($0, index($0, "[") + 1)
      t = substr(t, 1, index(t, "]") - 1)
      p = index($0, " :: ")
      if (p == 0) next
      txt = substr($0, p + 4)
      key = t "|" txt
      if (key in seen) { merged++; next }
      seen[key] = 1
      n++
      type[n] = t; text[n] = txt; source[n] = src
    }
    END {
      printf "# Memory · %s\n\n", NAME
      printf "Distilled on %s from %d episode entries. Every entry points back\n", TODAY, n + merged
      printf "to the episode it came from, so a claim can always be traced to the moment it\n"
      printf "was learned. Tend this file with harnemon rest, and keep it under 100 lines.\n"
      split("correction convention decision", ORDER, " ")
      split("Corrections Conventions Decisions", TITLE, " ")
      id = 0
      for (k = 1; k <= 3; k++) {
        want = ORDER[k]; printed = 0
        for (i = 1; i <= n; i++) {
          if (type[i] != want) continue
          if (!printed) { printf "\n## %s\n\n", TITLE[k]; printed = 1 }
          id++
          printf "- %s\n", text[i]
          printf "  <!-- id:m-%04d born:%s src:%s uses:0 last:- -->\n", id, TODAY, source[i]
        }
      }
      printf "%d %d\n", n, merged > "/dev/stderr"
    }
  ' "${files[@]}" > "$out" 2> "$dir/memory/.distill-stat"

  cat "$dir/memory/.distill-stat" 2>/dev/null || printf '0 0\n'
  rm -f "$dir/memory/.distill-stat"
}

cmd_note() {
  local text="" ntype="correction" target_dir="."

  while [ $# -gt 0 ]; do
    case "$1" in
      --type|-t) ntype="$2"; shift 2 ;;
      --dir|-C) target_dir="$2"; shift 2 ;;
      -*) echo "❌ Unknown option: $1"; exit 1 ;;
      *)
        if [ -z "$text" ]; then text="$1"; else target_dir="$1"; fi
        shift
        ;;
    esac
  done

  case "$ntype" in
    correction|convention|decision) ;;
    *) echo "❌ Error: --type must be correction, convention, or decision (got '$ntype')."; exit 1 ;;
  esac

  if [ -z "$text" ]; then
    echo "❌ Error: Nothing to record."
    echo "   Usage: harnemon note \"<what you learned>\" [--type correction|convention|decision]"
    exit 1
  fi

  target_dir="$(cd "$target_dir" && pwd)"
  local sdir
  sdir="$(memory_species_dir "$target_dir")"
  if [ -z "$sdir" ]; then
    echo "❌ Error: No Harnemon found at $target_dir/.harnemons."
    echo "   Run 'harnemon incubate' to start an egg first."
    exit 1
  fi

  local file
  file="$(memory_episode_file "$sdir")"
  printf -- '- [%s] %s :: %s\n' "$ntype" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$text" >> "$file"

  local entries corrections rules skills readiness
  read -r entries corrections rules skills <<< "$(memory_counts "$sdir")"
  readiness=$(memory_readiness "$entries" "$rules" "$skills")

  if memory_incubating "$sdir"; then
    echo "🌱 [Harnemon Incubating] Recorded a $ntype."
    echo "   ${file#$target_dir/}"
    echo "   Evidence: $entries entries ($corrections corrections) · Rules: $rules · Moves: $skills"
    echo "   Hatch readiness: ${readiness}%$([ "$readiness" -lt "$MEMORY_HATCH_MIN" ] && echo " (need ${MEMORY_HATCH_MIN}% to hatch)" || echo " · ready to hatch")"
  else
    echo "🧠 [Harnemon Memory] Recorded a $ntype."
    echo "   ${file#$target_dir/}"
    echo "   Evidence: $entries entries ($corrections corrections)"
    echo "   Distil it into MEMORY.md when it settles: harnemon rest --apply"
  fi
}

memory_cite() {
  # species_dir id -> bumps the use counter of one memory entry
  local file="$1/memory/MEMORY.md" id="$2" tmp
  [ -f "$file" ] || { echo "❌ Error: No MEMORY.md yet. It is written when the egg hatches."; return 1; }
  grep -q "id:$id " "$file" || { echo "❌ Error: No memory with id '$id'."; return 1; }
  tmp="$(mktemp)"
  awk -v ID="$id" -v TODAY="$(date -u +%Y-%m-%d)" '
    $0 ~ ("id:" ID " ") {
      u = $0; sub(/.*uses:/, "", u); sub(/ .*/, "", u)
      sub(/uses:[0-9]+/, "uses:" (u + 1), $0)
      sub(/last:[^ ]+/, "last:" TODAY, $0)
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
  echo "📌 Cited $id."
}

cmd_rest() {
  local target_dir="." days=90 apply=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --days|-d) days="$2"; shift 2 ;;
      --apply) apply=true; shift ;;
      --cite|-c) local cite_id="$2"; shift 2 ;;
      -*) echo "❌ Unknown option: $1"; exit 1 ;;
      *) target_dir="$1"; shift ;;
    esac
  done

  target_dir="$(cd "$target_dir" && pwd)"
  local sdir
  sdir="$(memory_species_dir "$target_dir")"
  if [ -z "$sdir" ]; then
    echo "❌ Error: No Harnemon found at $target_dir/.harnemons."
    exit 1
  fi

  if [ -n "${cite_id:-}" ]; then
    memory_cite "$sdir" "$cite_id"
    return $?
  fi

  local mem="$sdir/memory/MEMORY.md"
  if [ ! -f "$mem" ]; then
    local entries
    read -r entries _ _ _ <<< "$(memory_counts "$sdir")"
    if memory_incubating "$sdir" || [ "$entries" -eq 0 ]; then
      echo "🥚 Nothing to tend yet: MEMORY.md is distilled at hatch."
      echo "   Record what it learns in the meantime: harnemon note \"<text>\""
      return 0
    fi
    memory_distill "$sdir" "$(basename "$sdir")" >/dev/null
    echo "🧠 Distilled $entries episode entries into memory/MEMORY.md."
  fi

  local work
  work="$(mktemp -d)"
  local rule_files=("$sdir/rules/"*.md)
  [ -e "${rule_files[0]}" ] || rule_files=()

  awk -v DAYS="$days" -v TODAY="$(date -u +%Y-%m-%d)" -v OUT="$work" -v MEMFILE="$mem" '
function daynum(d,   y, m, dd) {
  y = substr(d,1,4) + 0; m = substr(d,6,2) + 0; dd = substr(d,9,2) + 0
  return int(365.25 * y) + int(30.6 * m) + dd
}
function clean(s) { gsub(/[.,;:!?()"`]/, "", s); return tolower(s) }
FILENAME != MEMFILE {
  ruletext[FILENAME] = ruletext[FILENAME] " " clean($0)
  next
}
{
  lines[++ln] = $0
}
/^- / && !/^- \[/ { pending = ln; pendingtext = substr($0, 3) }
/<!-- id:/ {
  id = $0; sub(/.*id:/, "", id); sub(/ .*/, "", id)
  born = $0; sub(/.*born:/, "", born); sub(/ .*/, "", born)
  uses = $0; sub(/.*uses:/, "", uses); sub(/ .*/, "", uses)
  n++
  eid[n] = id; etext[n] = pendingtext; ebase[n] = pending; ecomment[n] = ln
  eborn[n] = born; euses[n] = uses + 0
}
END {
  report = OUT "/report.txt"
  # 중복
  for (i = 1; i <= n; i++) {
    k = clean(etext[i])
    if (k in firstseen) { reason[i] = "duplicate of " eid[firstseen[k]]; kind[i] = "dup" }
    else firstseen[k] = i
  }
  # 규칙으로 이미 승격된 항목
  for (i = 1; i <= n; i++) {
    if (i in reason) continue
    split(clean(etext[i]), w, " ")
    for (f in ruletext) {
      hit = 0; tot = 0
      for (j in w) {
        if (length(w[j]) < 4) continue
        tot++
        if (index(ruletext[f], w[j]) > 0) hit++
      }
      if (tot >= 3 && hit / tot >= 0.6) {
        base = f; sub(/.*\//, "", base)
        reason[i] = "already covered by rules/" base; kind[i] = "promoted"
        break
      }
    }
  }
  # 오래도록 인용되지 않은 항목
  for (i = 1; i <= n; i++) {
    if (i in reason) continue
    if (euses[i] == 0 && daynum(TODAY) - daynum(eborn[i]) >= DAYS) {
      reason[i] = "never cited in " DAYS "+ days"; kind[i] = "stale"
    }
  }

  flagged = 0
  for (i = 1; i <= n; i++) if (i in reason) flagged++
  printf "%d %d %d\n", n, flagged, ln > (OUT "/stat")

  printf "" > report
  for (pass = 1; pass <= 3; pass++) {
    want = (pass == 1 ? "promoted" : (pass == 2 ? "dup" : "stale"))
    title = (pass == 1 ? "Already promoted into a rule" : (pass == 2 ? "Duplicates" : "Never cited"))
    shown = 0
    for (i = 1; i <= n; i++) {
      if (!(i in reason) || kind[i] != want) continue
      if (!shown) { printf "\n  %s\n", title >> report; shown = 1 }
      printf "    %s  %s\n", eid[i], etext[i] >> report
      printf "            → %s\n", reason[i] >> report
    }
  }

  # 적용본 작성: 폐기 대상 두 줄을 걷어내고 나머지는 그대로 둔다
  for (i = 1; i <= n; i++) if (i in reason) { drop[ebase[i]] = 1; drop[ecomment[i]] = 1; ret[ebase[i]] = i }
  newfile = OUT "/MEMORY.md"; retfile = OUT "/retired.add"
  printf "" > newfile; printf "" > retfile
  for (i = 1; i <= ln; i++) {
    if (i in ret) { j = ret[i]; printf "- %s\n  <!-- id:%s born:%s retired:%s reason:%s -->\n", etext[j], eid[j], eborn[j], TODAY, reason[j] >> retfile }
    if (i in drop) continue
    print lines[i] >> newfile
  }
}
' "${rule_files[@]}" "$mem"

  local total flagged linecount
  read -r total flagged linecount < "$work/stat"

  echo "😴 [Harnemon Rest] Tending memory at .harnemons/$(basename "$sdir")/"
  echo "──────────────────────────────────────────────"
  echo "   Memories: $total · Flagged: $flagged · MEMORY.md: $linecount lines"
  if [ "$linecount" -gt 100 ]; then
    echo "   ⚠️  Over the 100-line budget. Distill or retire before it crowds the prompt."
  fi

  if [ "$flagged" -eq 0 ]; then
    echo "──────────────────────────────────────────────"
    echo "✨ Nothing to retire. The memory is lean."
    rm -rf "$work"
    return 0
  fi

  cat "$work/report.txt"
  echo ""
  echo "──────────────────────────────────────────────"
  echo "   These are candidates, not verdicts. A memory that contradicts a current"
  echo "   rule needs your judgement, not a word count."

  if [ "$apply" != true ]; then
    echo "   Retire them with: harnemon rest --apply"
    rm -rf "$work"
    return 0
  fi

  local retired="$sdir/memory/retired.md"
  if [ ! -f "$retired" ]; then
    printf '# Retired Memories\n\nEntries retired from MEMORY.md, with the reason and the date.\nNothing here is deleted. An entry can be moved back into MEMORY.md at any time.\n' > "$retired"
  fi
  printf '\n## %s\n\n' "$(date -u +%Y-%m-%d)" >> "$retired"
  cat "$work/retired.add" >> "$retired"
  mv "$work/MEMORY.md" "$mem"
  rm -rf "$work"
  echo "   ✅ Retired $flagged $([ "$flagged" -eq 1 ] && echo memory || echo memories) into memory/retired.md"
}

cmd_status() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "⚡ [Harnemon Status] Inspecting Partner at: $target_dir"
  echo "──────────────────────────────────────────────"
  local partner_file=""
  if [ -f "$target_dir/.harnemons/partner.json" ]; then
    partner_file="$target_dir/.harnemons/partner.json"
  elif [ -f "$target_dir/.agents/partner.json" ]; then
    partner_file="$target_dir/.agents/partner.json"
  fi

  local species="nimbleet"
  local p_status="mature"
  if [ -n "$partner_file" ]; then
    local p_name p_type p_desc
    species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    p_name=$(grep -o '"name": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    p_type=$(grep -o '"type": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    p_desc=$(grep -o '"description": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    p_status=$(grep -o '"status": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4 || echo "mature")

    if [ "$species" = "egg" ] || [ "$p_status" = "incubating" ]; then
      echo "🐾 Partner: Harnemon Egg 🥚 [Incubating 🌱]"
      echo "   Trait:   $p_desc"
      echo "   Home:    .harnemons/egg/"
      sprite_show "$target_dir/.harnemons/egg/sprite.json" 26 "   "
      
      local obs_count corrections learned_rules learned_skills readiness exp
      read -r obs_count corrections learned_rules learned_skills <<< "$(memory_counts "$target_dir/.harnemons/egg")"
      readiness=$(memory_readiness "$obs_count" "$learned_rules" "$learned_skills")
      exp=$(memory_exp "$obs_count" "$learned_rules" "$learned_skills")
      
      echo "──────────────────────────────────────────────"
      echo "🌱 Incubation Progress:"
      echo "   • Hatch Readiness: ${readiness}% (need ${MEMORY_HATCH_MIN}%)"
      echo "   • EXP:             ${exp}"
      echo "   • Learned Rules:   ${learned_rules}"
      echo "   • Learned Moves:   ${learned_skills}"
      echo "   • Evidence:        ${obs_count} episodes (${corrections} corrections)"
      echo "──────────────────────────────────────────────"
      if [ "$readiness" -lt "$MEMORY_HATCH_MIN" ]; then
        echo "💡 Keep teaching it. Record what it learns: harnemon note \"<what you corrected>\""
      else
        echo "💡 Ready to hatch! Run: harnemon hatch <species-name>"
      fi
      return 0
    fi

    echo "🐾 Partner: $p_name [$p_type]"
    echo "   Trait:   $p_desc"
    [ -d "$target_dir/.harnemons/$species" ] && echo "   Home:    .harnemons/$species/"
    sprite_show "$target_dir/.harnemons/$species/sprite.json" 28 "   "
  else
    echo "🐾 Partner: Standard Harnemon"
  fi
  echo "──────────────────────────────────────────────"

  local rules_dir="$target_dir/.harnemons/$species/rules"
  [ ! -d "$rules_dir" ] && rules_dir="$target_dir/.agents/rules"
  if [ -d "$rules_dir" ]; then
    echo "📜 Active Abilities (Rules):"
    for r in "$rules_dir/"*.md; do
      [ -f "$r" ] || continue
      echo "   • $(basename "$r" .md)"
    done
  else
    echo "📜 Abilities: None"
  fi

  local skills_dir="$target_dir/.harnemons/$species/skills"
  [ ! -d "$skills_dir" ] && skills_dir="$target_dir/.agents/skills"
  if [ -d "$skills_dir" ]; then
    echo "🧰 Learned Moves (Skills):"
    for s in "$skills_dir/"*; do
      [ -d "$s" ] || continue
      echo "   • $(basename "$s")"
    done
    if [ -f "$skills_dir/INDEX.md" ]; then
      echo "   📋 Catalog: Active (.harnemons/$species/skills/INDEX.md)"
    fi
  else
    echo "🧰 Moves: None"
  fi

  local mem_dir="$target_dir/.harnemons/$species/memory"
  if [ -d "$mem_dir" ]; then
    local m_entries m_corrections
    read -r m_entries m_corrections _ _ <<< "$(memory_counts "$target_dir/.harnemons/$species")"
    echo "🧠 Episode Ledger:"
    echo "   • Evidence: ${m_entries} entries (${m_corrections} corrections)"
    if [ -f "$mem_dir/MEMORY.md" ]; then
      echo "   • Distilled: memory/MEMORY.md ($({ grep -c '^- ' "$mem_dir/MEMORY.md" || true; } 2>/dev/null) memories)"
    else
      echo "   • Distilled: not yet · harnemon rest --apply"
    fi
  fi

  local hooks_dir="$target_dir/.git/hooks"
  if [ -d "$hooks_dir" ]; then
    echo "🪝 Equipped Held Items (Hooks):"
    for h in "$hooks_dir/"*; do
      [ -x "$h" ] || continue
      local hn
      hn="$(basename "$h")"
      [[ "$hn" == *.sample ]] && continue
      echo "   • $hn"
    done
  else
    echo "🪝 Held Items: None"
  fi
  echo "──────────────────────────────────────────────"
  echo "✨ Ready for battle (coding sessions)!"
}

cmd_feed() {
  local use_link=false
  local target_dir=""
  local p_species="nimbleet"
  local p_name="Nimbleet"
  local p_type="Electric ⚡"
  local p_desc="50-token skill router, ultralight zero-dependency minimal speedster"
  local arg_idx=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --link|-l)
        use_link=true
        shift
        ;;
      *)
        case "$arg_idx" in
          0) target_dir="$1" ;;
          1) p_species="$1" ;;
          2) p_name="$1" ;;
          3) p_type="$1" ;;
          4) p_desc="$1" ;;
        esac
        arg_idx=$((arg_idx + 1))
        shift
        ;;
    esac
  done

  [ -z "$target_dir" ] && target_dir="."
  mkdir -p "$target_dir"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "⚡ [Harnemon] Awakening Harnemon in: $target_dir"
  echo "   🐾 Adopted Instance Mode: .harnemons/$p_species/ (100% Isolated & Clean)"
  echo "──────────────────────────────────────────────"

  local species_source="$SCRIPT_DIR/species/$p_species"
  if [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/species/$p_species" ]; then
    species_source="$GLOBAL_HOME/species/$p_species"
  elif [ ! -d "$species_source" ] && [ -d "$GLOBAL_HOME/catalog/$p_species" ]; then
    species_source="$GLOBAL_HOME/catalog/$p_species"
  fi

  if [ ! -d "$species_source" ]; then
    species_source="$SCRIPT_DIR/species/nimbleet"
  fi

  local harnemons_dir="$target_dir/.harnemons"
  mkdir -p "$harnemons_dir"
  local species_dir="$harnemons_dir/$p_species"
  mkdir -p "$species_dir"

  cat << EOF > "$harnemons_dir/partner.json"
{
  "species": "$p_species",
  "name": "$p_name",
  "type": "$p_type",
  "description": "$p_desc",
  "adopted_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
  sprite_write "$species_dir" "$p_species" "$p_type" 64 2>/dev/null || true

  cat << EOF > "$species_dir/partner.json"
{
  "species": "$p_species",
  "avatar": "avatar.svg",
  "name": "$p_name",
  "type": "$p_type",
  "description": "$p_desc",
  "adopted_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  echo "📜 Bestowing Abilities (Rules)..."
  local rules_target="$species_dir/rules"
  mkdir -p "$rules_target"
  local rules_src="$species_source/rules"
  for rf in "$rules_src/"*.md; do
    [ -f "$rf" ] || continue
    local bname
    bname="$(basename "$rf")"
        cp "$rf" "$rules_target/$bname"
    echo "   📄 Installed ability: .harnemons/$p_species/rules/$bname"
  done

  echo "🧰 Imprinting Moves (Skills)..."
  local skills_target="$species_dir/skills"
  mkdir -p "$skills_target"
  local skills_src="$species_source/skills"
  for sd in "$skills_src/"*; do
    local sname
    sname="$(basename "$sd")"
    if [ -d "$sd" ]; then
      mkdir -p "$skills_target/$sname"
      cp -R "$sd/"* "$skills_target/$sname/"
      echo "   📁 Learned move: .harnemons/$p_species/skills/$sname"
    elif [ -f "$sd" ]; then
      cp "$sd" "$skills_target/$sname"
    fi
  done
  if [ -f "$skills_src/INDEX.md" ]; then
    cp "$skills_src/INDEX.md" "$skills_target/INDEX.md"
    echo "   📋 Indexed catalog: .harnemons/$p_species/skills/INDEX.md"
  fi

  memory_scaffold "$species_dir"
  echo "🧠 Opening Episode Ledger..."
  echo "   📓 Ready: .harnemons/$p_species/memory/episodes/ (harnemon note \"<text>\")"

  if [ -d "$target_dir/.git" ]; then
    echo "🪝 Equipping Held Items (Git Hooks)..."
    local hooks_copy="$species_dir/hooks"
    mkdir -p "$hooks_copy"
    if [ -d "$SCRIPT_DIR/hooks" ]; then
      cp -R "$SCRIPT_DIR/hooks/"* "$hooks_copy/" 2>/dev/null || true
      if [ -f "$SCRIPT_DIR/hooks/install.sh" ]; then
        bash "$SCRIPT_DIR/hooks/install.sh" "$target_dir" >/dev/null 2>&1 || true
      fi
    fi
    git -C "$target_dir" config core.hooksPath .git/hooks 2>/dev/null || true
    echo "   ✅ Equipped: commit-msg, pre-commit (Pure Bash, Zero npm/pip/cargo deps)"

    echo "🛡️ Securing Personal Harnemon in .gitignore..."
    local gitignore="$target_dir/.gitignore"
    [ ! -f "$gitignore" ] && touch "$gitignore"

    local entries=(".harnemons/" ".claude/" ".gemini/" ".agents/")
    local added=0
    for entry in "${entries[@]}"; do
      if ! grep -q "^${entry}" "$gitignore" 2>/dev/null; then
        if [ "$added" -eq 0 ] && ! grep -q "# Harnemon Personal Companion" "$gitignore" 2>/dev/null; then
          [ -s "$gitignore" ] && echo "" >> "$gitignore"
          echo "# Harnemon Personal Companion" >> "$gitignore"
        fi
        echo "$entry" >> "$gitignore"
        added=$((added + 1))
      fi
    done

    if [ "$added" -gt 0 ]; then
      echo "   🛡️ Protected: .harnemons/ added to .gitignore"
    else
      echo "   🛡️ Protected: .harnemons/ already excluded in .gitignore"
    fi
  fi

  echo "🔌 Wiring AI Providers (.agents/, .claude/, .gemini/)..."
  mkdir -p "$target_dir/.agents" "$target_dir/.claude" "$target_dir/.gemini"

  rm -rf "$target_dir/.agents/skills"
  ln -sf "../.harnemons/$p_species/skills" "$target_dir/.agents/skills"
  echo "   🔌 Wired: .agents/skills -> ../.harnemons/$p_species/skills"

  rm -rf "$target_dir/.claude/skills"
  ln -sf "../.harnemons/$p_species/skills" "$target_dir/.claude/skills"
  echo "   🔌 Wired: .claude/skills -> ../.harnemons/$p_species/skills (Claude Code Native Scan)"

  generate_agents_md "$target_dir" "$p_species" "$p_name" "$p_type" "$p_desc" "" "Partner"
  echo "   🔌 Wired: .claude/CLAUDE.md & .gemini/GEMINI.md -> .agents/AGENTS.md"

  echo "──────────────────────────────────────────────"
  echo "✨ [Harnemon] $p_name successfully awakened in this folder!"
  echo "   Harnemon Home: .harnemons/$p_species/"
  echo "   Dependency footprint: 0 bytes. Build tools untouched."
}

cmd_link() {
  cmd_feed --link "${1:-.}"
}

cmd_sync() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🔄 [Harnemon Cross-Pollination] Syncing skills to global belt..."
  if [ ! -d "$GLOBAL_HOME/skills" ]; then
    echo "❌ Error: Global Harnemon home ($GLOBAL_HOME) not found."
    exit 1
  fi

  local count=0
  local local_skills="$target_dir/.agents/skills"
  if [ -d "$local_skills" ] && [ ! -L "$local_skills" ]; then
    for sd in "$local_skills/"*; do
      [ -d "$sd" ] || continue
      local sname
      sname="$(basename "$sd")"
      if [ ! -d "$GLOBAL_HOME/skills/$sname" ]; then
        echo "   🌟 New move discovered in project: $sname"
        mkdir -p "$GLOBAL_HOME/skills/$sname"
        cp -R "$sd/"* "$GLOBAL_HOME/skills/$sname/"
        count=$((count + 1))
      fi
    done
  fi

  echo "✨ Synced $count new move(s) to global Harnedex ($GLOBAL_HOME/skills)."
  echo "   All linked projects can now access these moves."
}

cmd_init() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "❌ Error: Please specify a Harnemon name."
    echo "   Usage: harnemon init <harness-name>"
    exit 1
  fi

  local target_dir
  if [[ "$name" = /* ]]; then
    target_dir="$name"
  else
    target_dir="./$name"
  fi
  local base_name
  base_name="$(basename "$name")"

  if [ -d "$target_dir" ]; then
    echo "❌ Error: Directory '$target_dir' already exists."
    exit 1
  fi

  echo "🚀 [Harnemon] Breeding new 3-Pillar Harnemon: $base_name at $target_dir..."
  mkdir -p "$target_dir/rules" "$target_dir/skills/harness-evolution" "$target_dir/hooks/commit-msg" "$target_dir/hooks/pre-commit" "$target_dir/docs"

  if [ -d "$SCRIPT_DIR/rules" ]; then
    cp "$SCRIPT_DIR/rules/"*.md "$target_dir/rules/" 2>/dev/null || true
  fi

  if [ -d "$SCRIPT_DIR/skills/harness-evolution" ]; then
    cp -R "$SCRIPT_DIR/skills/harness-evolution/"* "$target_dir/skills/harness-evolution/"
  fi

  if [ -d "$SCRIPT_DIR/hooks" ]; then
    cp -R "$SCRIPT_DIR/hooks/"* "$target_dir/hooks/" 2>/dev/null || true
  fi

  echo "✨ Harnemon '$base_name' bred successfully at $target_dir"
}

cmd_audit() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🔍 [Harnemon Health] Diagnosing Harnemon at: $target_dir"
  echo "──────────────────────────────────────────────"

  local partner_file="$target_dir/.harnemons/partner.json"
  if [ -f "$partner_file" ]; then
    local p_species
    p_species=$(grep -o '"species": "[^"]*' "$partner_file" | head -n 1 | cut -d'"' -f4)
    if [ "$p_species" = "egg" ]; then
      echo "🥚 Diagnosing Incubating Harnemon Egg..."
      echo "   ✅ Kernel active: incubation-kernel.md"
      echo "   ✅ Self-evolution active: harness-evolution.md"
      echo "   ✅ Episode log: memory/episodes/"
      echo "──────────────────────────────────────────────"
      echo "✨ Harnemon Egg is in prime condition. Keep coding to hatch!"
      return 0
    fi
  fi

  local issues=0

  echo "📜 Checking Abilities (Rules)..."
  local rules_dir="$target_dir/rules"
  if [ ! -d "$rules_dir" ]; then
    local h_rules
    h_rules="$(find "$target_dir/.harnemons" -maxdepth 2 -type d -name "rules" 2>/dev/null | head -n 1 || true)"
    if [ -n "$h_rules" ] && [ -d "$h_rules" ]; then
      rules_dir="$h_rules"
    elif [ -d "$target_dir/.agents/rules" ]; then
      rules_dir="$target_dir/.agents/rules"
    fi
  fi

  local has_evolution=0
  if [ -d "$rules_dir" ]; then
    for rf in "$rules_dir/"*.md; do
      [ -f "$rf" ] || continue
      local lines
      lines=$(wc -l < "$rf" | tr -d ' ')
      local bname
      bname=$(basename "$rf")

      if [ "$bname" = "harness-evolution.md" ]; then
        has_evolution=1
      fi

      if [ "$lines" -gt 100 ]; then
        echo "   ⚠️  [Overburdened] '$bname' is $lines lines. Keep abilities < 100 lines."
        echo "       Consider moving deep moves to an on-demand Skill and using Skill Routing."
        issues=$((issues + 1))
      else
        echo "   ✅ '$bname' ($lines lines) — Healthy size"
      fi
    done
  else
    echo "   ⚠️  No rules/abilities directory found."
    issues=$((issues + 1))
  fi

  if [ "$has_evolution" -eq 1 ]; then
    echo "   🌟 Self-evolution ability (harness-evolution.md) is ACTIVE"
  else
    echo "   ℹ️  Self-evolution ability not found. Harnemon cannot autonomously evolve."
  fi

  echo "🧰 Checking Learned Moves (Skills)..."
  local skills_dir="$target_dir/skills"
  if [ ! -d "$skills_dir" ]; then
    local h_skills
    h_skills="$(find "$target_dir/.harnemons" -maxdepth 2 -type d -name "skills" 2>/dev/null | head -n 1 || true)"
    if [ -n "$h_skills" ] && [ -d "$h_skills" ]; then
      skills_dir="$h_skills"
    elif [ -d "$target_dir/.agents/skills" ]; then
      skills_dir="$target_dir/.agents/skills"
    fi
  fi

  if [ -d "$skills_dir" ]; then
    if [ -L "$skills_dir" ]; then
      echo "   🔗 Moveset is symlinked to global belt: $(readlink "$skills_dir")"
    else
      for sd in "$skills_dir/"*; do
        [ -d "$sd" ] || continue
        local sname
        sname=$(basename "$sd")
        if [ ! -f "$sd/SKILL.md" ]; then
          echo "   ❌ '$sname' is missing SKILL.md move definition."
          issues=$((issues + 1))
        else
          echo "   ✅ '$sname/SKILL.md' ready"
        fi
      done
    fi
  else
    echo "   ℹ️  No skills found."
  fi

  echo "🪝 Checking Held Items (Hooks)..."
  local hooks_dir="$target_dir/hooks"
  if [ ! -d "$hooks_dir" ] && [ -d "$target_dir/.git/hooks" ]; then
    hooks_dir="$target_dir/.git/hooks"
  fi

  if [ -d "$hooks_dir" ]; then
    for hk in "$hooks_dir/"*; do
      [ -e "$hk" ] || continue
      local hname
      hname=$(basename "$hk")
      [[ "$hname" == *.sample ]] && continue
      if [ -f "$hk" ]; then
        if [ ! -x "$hk" ]; then
          echo "   ⚠️  Held item '$hname' is not equipped (chmod +x needed)."
          issues=$((issues + 1))
        else
          echo "   ✅ Held item '$hname' equipped"
        fi
      fi
    done
  else
    echo "   ℹ️  No hooks found."
  fi

  echo "──────────────────────────────────────────────"
  if [ "$issues" -eq 0 ]; then
    echo "✨ Harnemon is in peak condition! 3-Pillar stats and self-evolution verified."
  else
    echo "⚠️  Found $issues health check issue(s). Treat with Harnemon recommendations."
  fi
}

cmd_dex() {
  echo "📖 [Harnedex] Legendary Gen-1 Harnemon Archetypes & Custom Species"
  echo "──────────────────────────────────────────────"
  echo "No.000 Harnemon Egg — Incubating 🌱"
  echo "       • Blank canvas starter absorbing developer habits and 2-correction feedback"
  echo ""
  echo "No.001 Nimbleet    — Electric Type ⚡"
  echo "       • Jihan Harness: 50-token skill router, zero-dependency root-clean"
  echo "       • Entry: docs/case-studies/01-jihan-harness.md"
  echo ""
  echo "No.002 Fortoise    — Water Type 💧"
  echo "       • Everything Claude: 288 moves, Config-Guard hard gate shell"
  echo "       • Entry: docs/case-studies/02-everything-claude-code.md"
  echo ""
  echo "No.003 Monkin      — Fire Type 🔥"
  echo "       • Superpowers: The Iron Law discipline, rigorous TDD crucible"
  echo "       • Entry: docs/case-studies/03-obra-superpowers.md"
  echo ""
  echo "No.004 Yagni       — Grass Type 🍃"
  echo "       • Ponytail: Ladder of Laziness, complexity pruning (-N lines)"
  echo "       • Entry: docs/case-studies/04-dietrich-ponytail.md"

  if [ -d "$GLOBAL_HOME/catalog" ]; then
    for cd in "$GLOBAL_HOME/catalog/"*; do
      [ -d "$cd" ] || continue
      local cname
      cname="$(basename "$cd")"
      local cat_json="$cd/partner.json"
      if [ -f "$cat_json" ]; then
        local cn ct cd_desc
        cn=$(grep -o '"name": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        ct=$(grep -o '"type": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        cd_desc=$(grep -o '"description": "[^"]*' "$cat_json" | head -n 1 | cut -d'"' -f4)
        echo ""
        echo "🌟 Custom: $cn — $ct"
        echo "       • $cd_desc"
      fi
    done
  fi
  echo "──────────────────────────────────────────────"
  echo "Inspect detailed entries in $SCRIPT_DIR/docs/case-studies/"
}

case "${1:-}" in
  setup|global|init-global)
    shift
    cmd_setup "$@"
    ;;
  update|upgrade)
    shift
    cmd_update "$@"
    ;;
  adopt|recruit|add)
    shift
    cmd_adopt "$@"
    ;;
  party)
    shift
    cmd_party "$@"
    ;;
  switch)
    shift
    cmd_switch "$@"
    ;;
  dismiss|remove)
    shift
    cmd_dismiss "$@"
    ;;
  release|uninstall)
    shift
    cmd_release "$@"
    ;;
  incubate|egg)
    shift
    cmd_incubate "$@"
    ;;
  hatch)
    shift
    cmd_hatch "$@"
    ;;
  register)
    shift
    cmd_register "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  draw|art)
    shift
    cmd_draw "$@"
    ;;
  note|learn)
    shift
    cmd_note "$@"
    ;;
  rest|sleep)
    shift
    cmd_rest "$@"
    ;;
  feed)
    shift
    cmd_feed "$@"
    ;;
  link)
    shift
    cmd_link "$@"
    ;;
  sync)
    shift
    cmd_sync "$@"
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  audit)
    shift
    cmd_audit "$@"
    ;;
  dex|cases)
    cmd_dex
    ;;
  version|-v|check|check-update)
    shift
    cmd_version "$@"
    ;;
  help|-h|"")
    show_help
    ;;
  *)
    echo "❌ Unknown command: $1"
    show_help
    exit 1
    ;;
esac
