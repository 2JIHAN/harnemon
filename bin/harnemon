case "${1:-}" in
  adopt)
    shift
    cmd_adopt "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  feed)
    shift
    cmd_feed "$@"
    ;;
  link)
    shift
    cmd_link "$@"
    ;;
  sync)
    shift
    cmd_sync "$@"
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  audit)
    shift
    cmd_audit "$@"
    ;;
  dex|cases)
    cmd_dex
    ;;
  version|-v)
    echo "harnemon v$VERSION"
    ;;
  help|-h|"")
    show_help
    ;;
  *)
    echo "❌ Unknown command: $1"
    show_help
    exit 1
    ;;
esac
