#!/usr/bin/env bash
# bin/harnemon — Harnemon (하네몬) CLI
# The Pokémon-Style, Zero-Dependency Harness Companion for AI Coding Agents.
set -euo pipefail

VERSION="0.6.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GLOBAL_HOME="${HOME}/.harnemon"

show_help() {
  cat << 'EOF'
  ⚡ HARNEMON (하네몬) ⚡
  The Pokémon-Style, Zero-Dependency Autonomous Harness Companion

Usage:
  harnemon <command> [arguments] [options]

Commands:
  adopt [species] [path]  Adopt a starter Harnemon interactively or by name (1: Routis, 2: Bastion, 3: Ironik, 4: Yagni)
  status [path]           Check your adopted partner's profile, moves, and held items
  feed [--link] [path]    Feed a Harness Pill to awaken a Harnemon (default: current directory)
  link [path]             Zero-dependency link: bind project to global Harnemon (~/.harnemon)
  sync [path]             Cross-pollinate: sync locally learned moves back to global Harnedex
  dex                     Open the Harnedex (하네몬 도감) to inspect legendary archetypes
  audit [path]            Diagnose Harnemon health, token bloat, and rule integrity
  init <name>             Scaffold a new custom Harnemon species repository
  help, -h                Show this help message
  version, -v             Show Harnemon version

The Pokémon Architecture:
  • Global Harnemon = Class / Species (원형 설계도 / 피카츄라는 '종')
  • Project Harnemon = Instance / Individual (이 레포에 분양되어 특화 진화하는 '지우의 피카츄')
  • Zero Dependencies: 100% POSIX Bash & Git, 0 npm/pip/cargo packages required

Examples:
  harnemon adopt                       # Interactive starter selection (Routis, Bastion, Ironik, Yagni)
  harnemon adopt 1                     # Direct adopt: Routis (민첩 / 강철)
  harnemon adopt yagni                 # Direct adopt: Yagni (노말 / 풀)
  harnemon status                      # View current partner's stats and abilities
  harnemon audit                       # Health-check your partner
  harnemon dex                         # Browse the 4 legendary Harnemons
EOF
}

choose_starter_interactive() {
  echo "" >&2
  echo "┌──────────────────────────────────────────────────────────────┐" >&2
  echo "│   🌟 스타팅 하네몬을 선택하세요! (Choose Your Starter)      │" >&2
  echo "│   오박사의 연구소처럼, 함께 모험할 파트너를 선택합니다.     │" >&2
  echo "└──────────────────────────────────────────────────────────────┘" >&2
  echo "" >&2
  echo "  1) ⚡ 루티스 (Routis)    [민첩 / 강철]  50토큰 스킬 라우터, 초경량 미니멀 종족" >&2
  echo "  2) 🛡️ 바스티온 (Bastion) [바위 / 드래곤] 288개 기술 요새, 린트 설정 수호 종족" >&2
  echo "  3) 🥋 아이로닉 (Ironik)  [격투 / 에스퍼] 철칙(The Iron Law)의 4단계 디버깅 종족" >&2
  echo "  4) 🍃 야그니 (Yagni)     [노말 / 풀]     게으름의 사다리, 복잡성 삭제(-N lines) 종족" >&2
  echo "" >&2
  printf "파트너 선택 (1-4) [기본값: 1 루티스]: " >&2
  local choice=""
  if read -r choice; then
    :
  else
    choice="1"
  fi
  [ -z "$choice" ] && choice="1"

  case "$choice" in
    2|bastion|바스티온) echo "bastion" ;;
    3|ironik|아이로닉)   echo "ironik" ;;
    4|yagni|야그니)     echo "yagni" ;;
    1|routis|루티스|*)  echo "routis" ;;
  esac
}

cmd_adopt() {
  local species=""
  local target_dir="."

  if [ $# -gt 0 ]; then
    case "$1" in
      routis|bastion|ironik|yagni)
        species="$1"
        shift
        ;;
      1) species="routis"; shift ;;
      2) species="bastion"; shift ;;
      3) species="ironik"; shift ;;
      4) species="yagni"; shift ;;
    esac
  fi

  if [ $# -gt 0 ]; then
    target_dir="$1"
  fi

  if [ -z "$species" ]; then
    species="$(choose_starter_interactive)"
  fi

  local species_name=""
  local species_type=""
  local species_desc=""

  case "$species" in
    routis)
      species_name="루티스 (Routis)"
      species_type="민첩 / 강철"
      species_desc="50토큰 스킬 라우터 장착, 초경량 제로 디펜던시 미니멀 종족"
      ;;
    bastion)
      species_name="바스티온 (Bastion)"
      species_type="바위 / 드래곤"
      species_desc="린터 및 포맷터 설정 수호, 강력한 Git 라이프사이클 게이트 종족"
      ;;
    ironik)
      species_name="아이로닉 (Ironik)"
      species_type="격투 / 에스퍼"
      species_desc="철칙(The Iron Law) 디버깅, 근본 원인 규명 우선 수련 종족"
      ;;
    yagni)
      species_name="야그니 (Yagni)"
      species_type="노말 / 풀"
      species_desc="게으름의 사다리, 불필요한 코드 라인 삭제 베기(-N lines) 종족"
      ;;
  esac

  echo ""
  echo "🎉 축하합니다! '$species_name [$species_type]'이(가) 파트너로 선택되었습니다!"
  echo "   특징: $species_desc"
  echo ""

  cmd_feed --link "$target_dir" "$species" "$species_name" "$species_type" "$species_desc"
}

cmd_status() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "⚡ [Harnemon Status] Inspecting Partner at: $target_dir"
  echo "──────────────────────────────────────────────"
  if [ -f "$target_dir/.agents/partner.json" ]; then
    local p_name p_type p_desc
    p_name=$(grep -o '"name": "[^"]*' "$target_dir/.agents/partner.json" | head -n 1 | cut -d'"' -f4)
    p_type=$(grep -o '"type": "[^"]*' "$target_dir/.agents/partner.json" | head -n 1 | cut -d'"' -f4)
    p_desc=$(grep -o '"description": "[^"]*' "$target_dir/.agents/partner.json" | head -n 1 | cut -d'"' -f4)
    echo "🐾 Partner: $p_name [$p_type]"
    echo "   Motto:   $p_desc"
  else
    echo "🐾 Partner: 일반 하네몬 (Standard Harnemon)"
  fi
  echo "──────────────────────────────────────────────"

  local rules_dir="$target_dir/.agents/rules"
  if [ -d "$rules_dir" ]; then
    echo "📜 Active Abilities (Rules):"
    for r in "$rules_dir/"*.md; do
      [ -f "$r" ] || continue
      echo "   • $(basename "$r" .md)"
    done
  else
    echo "📜 Abilities: None"
  fi

  local skills_dir="$target_dir/.agents/skills"
  if [ -d "$skills_dir" ]; then
    echo "🧰 Learned Moves (Skills):"
    for s in "$skills_dir/"*; do
      [ -d "$s" ] || continue
      echo "   • $(basename "$s")"
    done
  else
    echo "🧰 Moves: None"
  fi

  local hooks_dir="$target_dir/.git/hooks"
  if [ -d "$hooks_dir" ]; then
    echo "🪝 Equipped Held Items (Hooks):"
    for h in "$hooks_dir/"*; do
      [ -x "$h" ] || continue
      local hn
      hn="$(basename "$h")"
      [[ "$hn" == *.sample ]] && continue
      echo "   • $hn"
    done
  else
    echo "🪝 Held Items: None"
  fi
  echo "──────────────────────────────────────────────"
  echo "✨ Ready for battle (coding sessions)!"
}

cmd_feed() {
  local use_link=false
  local target_dir=""
  local p_species="standard"
  local p_name="하네몬 (Harnemon)"
  local p_type="노말"
  local p_desc="3대 기둥과 자가 진화 능력을 지닌 표준 하네몬"

  while [ $# -gt 0 ]; do
    case "$1" in
      --link|-l)
        use_link=true
        shift
        ;;
      *)
        if [ -z "$target_dir" ]; then
          target_dir="$1"
        elif [ "$p_species" = "standard" ]; then
          p_species="$1"
        elif [ "$p_name" = "하네몬 (Harnemon)" ]; then
          p_name="$1"
        elif [ "$p_type" = "노말" ]; then
          p_type="$1"
        elif [ "$p_desc" = "3대 기둥과 자가 진화 능력을 지닌 표준 하네몬" ]; then
          p_desc="$1"
        fi
        shift
        ;;
    esac
  done

  [ -z "$target_dir" ] && target_dir="."
  mkdir -p "$target_dir"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "⚡ [Harnemon] Awakening Harnemon in: $target_dir"
  if [ "$use_link" = true ]; then
    echo "   🔗 Roaming Mode: Symlinked to global belt ($GLOBAL_HOME) — 0 project dependencies"
  else
    echo "   📦 Isolated Mode: Standalone files copied — 0 build footprint"
  fi
  echo "──────────────────────────────────────────────"

  local base_source="$SCRIPT_DIR"
  if [ -d "$GLOBAL_HOME" ]; then
    base_source="$GLOBAL_HOME"
  fi

  # 1. Install Rules (Abilities)
  echo "📜 Bestowing Abilities (Rules)..."
  local rules_target="$target_dir/.agents/rules"
  mkdir -p "$rules_target"

  if [ "$use_link" = true ]; then
    for rf in "$base_source/rules/"*.md; do
      [ -f "$rf" ] || continue
      local bname
      bname="$(basename "$rf")"
      ln -sf "$rf" "$rules_target/$bname"
      echo "   🔗 Linked ability: .agents/rules/$bname -> $rf"
    done
  else
    for rf in "$base_source/rules/"*.md; do
      [ -f "$rf" ] || continue
      local bname
      bname="$(basename "$rf")"
      cp "$rf" "$rules_target/$bname"
      echo "   📄 Installed ability: .agents/rules/$bname"
    done
  fi

  # Save partner profile
  cat << EOF > "$target_dir/.agents/partner.json"
{
  "species": "$p_species",
  "name": "$p_name",
  "type": "$p_type",
  "description": "$p_desc",
  "adopted_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

  # Auto-wire AGENTS.md
  local agents_md="$target_dir/.agents/AGENTS.md"
  if [ ! -f "$agents_md" ]; then
    cat << EOF > "$agents_md"
# Harnemon Operating Rules (AGENTS.md)

**Partner**: $p_name [$p_type]
**Description**: $p_desc

This project is governed by an adopted Harnemon companion with the 3 Pillars (Rule, Skill, Hook).

## Active Abilities (Rules)
EOF
    echo "   📝 Created: .agents/AGENTS.md"
  fi

  for rf in "$rules_target/"*.md; do
    [ -f "$rf" ] || continue
    local bname
    bname="$(basename "$rf")"
    if ! grep -q "@rules/$bname" "$agents_md"; then
      echo "@rules/$bname" >> "$agents_md"
      echo "   🔌 Wired '$bname' into .agents/AGENTS.md"
    fi
  done

  # Wire Claude and Gemini configs
  mkdir -p "$target_dir/.claude" "$target_dir/.gemini"
  [ ! -f "$target_dir/.claude/CLAUDE.md" ] && echo "@../.agents/AGENTS.md" > "$target_dir/.claude/CLAUDE.md"
  [ ! -f "$target_dir/.gemini/GEMINI.md" ] && echo "@../.agents/AGENTS.md" > "$target_dir/.gemini/GEMINI.md"

  # 2. Install Skills (Moves)
  echo "🧰 Imprinting Moves (Skills)..."
  local skills_target="$target_dir/.agents/skills"

  if [ "$use_link" = true ]; then
    rm -rf "$skills_target"
    ln -sf "$base_source/skills" "$skills_target"
    echo "   🔗 Linked moveset: .agents/skills -> $base_source/skills"
  else
    mkdir -p "$skills_target"
    for sd in "$base_source/skills/"*; do
      [ -d "$sd" ] || continue
      local sname
      sname="$(basename "$sd")"
      mkdir -p "$skills_target/$sname"
      cp -R "$sd/"* "$skills_target/$sname/"
      echo "   📁 Learned move: .agents/skills/$sname"
    done
  fi

  # Wire .claude/skills symlink
  rm -rf "$target_dir/.claude/skills"
  ln -sf "../.agents/skills" "$target_dir/.claude/skills"
  echo "   🔌 Wired: .claude/skills -> ../.agents/skills"

  # 3. Install Git Hooks (Held Items)
  if [ -d "$target_dir/.git" ]; then
    echo "🪝 Equipping Held Items (Git Hooks)..."
    local hooks_target="$target_dir/.git/hooks"
    mkdir -p "$hooks_target"

    if [ -d "$base_source/hooks" ]; then
      if [ -f "$base_source/hooks/install.sh" ]; then
        bash "$base_source/hooks/install.sh" "$target_dir" >/dev/null 2>&1 || true
      fi
    fi
    git -C "$target_dir" config core.hooksPath .git/hooks 2>/dev/null || true
    echo "   ✅ Equipped: commit-msg, pre-commit (Pure Bash, Zero npm/pip/cargo deps)"
  fi

  echo "──────────────────────────────────────────────"
  echo "✨ [Harnemon] $p_name successfully awakened in this folder!"
  echo "   Dependency footprint: 0 bytes. Build tools untouched."
  if [ "$use_link" = true ]; then
    echo "   Global belt connected: Any evolution in ~/.harnemon is live immediately."
  fi
}

cmd_link() {
  cmd_feed --link "${1:-.}"
}

cmd_sync() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🔄 [Harnemon Cross-Pollination] Syncing skills to global belt..."
  if [ ! -d "$GLOBAL_HOME/skills" ]; then
    echo "❌ Error: Global Harnemon home ($GLOBAL_HOME) not found."
    exit 1
  fi

  local count=0
  local local_skills="$target_dir/.agents/skills"
  if [ -d "$local_skills" ] && [ ! -L "$local_skills" ]; then
    for sd in "$local_skills/"*; do
      [ -d "$sd" ] || continue
      local sname
      sname="$(basename "$sd")"
      if [ ! -d "$GLOBAL_HOME/skills/$sname" ]; then
        echo "   🌟 New move discovered in project: $sname"
        mkdir -p "$GLOBAL_HOME/skills/$sname"
        cp -R "$sd/"* "$GLOBAL_HOME/skills/$sname/"
        count=$((count + 1))
      fi
    done
  fi

  echo "✨ Synced $count new move(s) to global Harnedex ($GLOBAL_HOME/skills)."
  echo "   All linked projects can now access these moves."
}

cmd_init() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "❌ Error: Please specify a Harnemon name."
    echo "   Usage: harnemon init <harness-name>"
    exit 1
  fi

  local target_dir
  if [[ "$name" = /* ]]; then
    target_dir="$name"
  else
    target_dir="./$name"
  fi
  local base_name
  base_name="$(basename "$name")"

  if [ -d "$target_dir" ]; then
    echo "❌ Error: Directory '$target_dir' already exists."
    exit 1
  fi

  echo "🚀 [Harnemon] Breeding new 3-Pillar Harnemon: $base_name at $target_dir..."
  mkdir -p "$target_dir/rules" "$target_dir/skills/harness-evolution" "$target_dir/hooks/commit-msg" "$target_dir/hooks/pre-commit" "$target_dir/docs"

  if [ -d "$SCRIPT_DIR/rules" ]; then
    cp "$SCRIPT_DIR/rules/"*.md "$target_dir/rules/" 2>/dev/null || true
  fi

  if [ -d "$SCRIPT_DIR/skills/harness-evolution" ]; then
    cp -R "$SCRIPT_DIR/skills/harness-evolution/"* "$target_dir/skills/harness-evolution/"
  fi

  if [ -d "$SCRIPT_DIR/hooks" ]; then
    cp -R "$SCRIPT_DIR/hooks/"* "$target_dir/hooks/" 2>/dev/null || true
  fi

  cat << 'EOF' > "$target_dir/install.sh"
#!/usr/bin/env bash
# install.sh — Idempotent installer for Harnemon
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${1:-.}"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

echo "⚡ Awakening Harnemon in: $TARGET_DIR"

if [ -d "$TARGET_DIR/.git" ]; then
  mkdir -p "$TARGET_DIR/.git/hooks"
  [ -f "$SCRIPT_DIR/hooks/commit-msg/commit-msg" ] && cp "$SCRIPT_DIR/hooks/commit-msg/commit-msg" "$TARGET_DIR/.git/hooks/commit-msg"
  [ -f "$SCRIPT_DIR/hooks/pre-commit/pre-commit" ] && cp "$SCRIPT_DIR/hooks/pre-commit/pre-commit" "$TARGET_DIR/.git/hooks/pre-commit"
  chmod +x "$TARGET_DIR/.git/hooks/"* 2>/dev/null || true
  git -C "$TARGET_DIR" config core.hooksPath .git/hooks 2>/dev/null || true
fi

mkdir -p "$TARGET_DIR/.agents/rules"
cp "$SCRIPT_DIR/rules/"*.md "$TARGET_DIR/.agents/rules/" 2>/dev/null || true

AGENTS_MD="$TARGET_DIR/.agents/AGENTS.md"
[ ! -f "$AGENTS_MD" ] && touch "$AGENTS_MD"

for rule in "$TARGET_DIR/.agents/rules/"*.md; do
  [ -f "$rule" ] || continue
  base="$(basename "$rule")"
  if ! grep -q "@rules/$base" "$AGENTS_MD"; then
    echo "@rules/$base" >> "$AGENTS_MD"
  fi
done

mkdir -p "$TARGET_DIR/.claude" "$TARGET_DIR/.gemini"
[ ! -f "$TARGET_DIR/.claude/CLAUDE.md" ] && echo "@../.agents/AGENTS.md" > "$TARGET_DIR/.claude/CLAUDE.md"
[ ! -f "$TARGET_DIR/.gemini/GEMINI.md" ] && echo "@../.agents/AGENTS.md" > "$TARGET_DIR/.gemini/GEMINI.md"

mkdir -p "$TARGET_DIR/.agents/skills"
for sd in "$SCRIPT_DIR/skills/"*; do
  [ -d "$sd" ] || continue
  sname="$(basename "$sd")"
  mkdir -p "$TARGET_DIR/.agents/skills/$sname"
  cp -R "$sd/"* "$TARGET_DIR/.agents/skills/$sname/"
done
ln -sf "../.agents/skills" "$TARGET_DIR/.claude/skills" 2>/dev/null || true

echo "✨ Harnemon awakened successfully with ZERO project dependencies."
EOF
  chmod +x "$target_dir/install.sh"

  cat << EOF > "$target_dir/README.md"
# $base_name

A custom Harnemon species built with [Harnemon (하네몬)](https://github.com/2JIHAN/harnemon).

## Harnemon Spec (Zero Build Dependencies)

- **Abilities (\`rules/\`)** — Operational standards, skill routing, and self-evolution
- **Moves (\`skills/\`)** — On-demand capabilities and evolution playbook
- **Held Items (\`hooks/\`)** — Git-level deterministic hard gates (Pure Bash)

## Feed & Awaken

\`\`\`bash
./install.sh /path/to/target-project
\`\`\`
EOF

  echo "✨ Harnemon '$base_name' bred successfully at $target_dir"
}

cmd_audit() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo "🔍 [Harnemon Health] Diagnosing Harnemon at: $target_dir"
  echo "──────────────────────────────────────────────"

  local issues=0

  # 1. Check Rules (Abilities)
  echo "📜 Checking Abilities (Rules)..."
  local rules_dir="$target_dir/rules"
  if [ ! -d "$rules_dir" ] && [ -d "$target_dir/.agents/rules" ]; then
    rules_dir="$target_dir/.agents/rules"
  fi

  local has_evolution=0
  if [ -d "$rules_dir" ]; then
    for rf in "$rules_dir/"*.md; do
      [ -f "$rf" ] || continue
      local lines
      lines=$(wc -l < "$rf" | tr -d ' ')
      local bname
      bname=$(basename "$rf")

      if [ "$bname" = "harness-evolution.md" ]; then
        has_evolution=1
      fi

      if [ "$lines" -gt 100 ]; then
        echo "   ⚠️  [Overburdened] '$bname' is $lines lines. Keep abilities < 100 lines."
        echo "       Consider moving deep moves to an on-demand Skill and using Skill Routing."
        issues=$((issues + 1))
      else
        echo "   ✅ '$bname' ($lines lines) — Healthy size"
      fi
    done
  else
    echo "   ⚠️  No rules/abilities directory found."
    issues=$((issues + 1))
  fi

  if [ "$has_evolution" -eq 1 ]; then
    echo "   🌟 Self-evolution ability (harness-evolution.md) is ACTIVE"
  else
    echo "   ℹ️  Self-evolution ability not found. Harnemon cannot autonomously evolve."
  fi

  # 2. Check Skills (Moves)
  echo "🧰 Checking Learned Moves (Skills)..."
  local skills_dir="$target_dir/skills"
  if [ ! -d "$skills_dir" ] && [ -d "$target_dir/.agents/skills" ]; then
    skills_dir="$target_dir/.agents/skills"
  fi

  if [ -d "$skills_dir" ]; then
    if [ -L "$skills_dir" ]; then
      echo "   🔗 Moveset is symlinked to global belt: $(readlink "$skills_dir")"
    else
      for sd in "$skills_dir/"*; do
        [ -d "$sd" ] || continue
        local sname
        sname=$(basename "$sd")
        if [ ! -f "$sd/SKILL.md" ]; then
          echo "   ❌ '$sname' is missing SKILL.md move definition."
          issues=$((issues + 1))
        else
          echo "   ✅ '$sname/SKILL.md' ready"
        fi
      done
    fi
  else
    echo "   ℹ️  No skills found."
  fi

  # 3. Check Hooks (Held Items)
  echo "🪝 Checking Held Items (Hooks)..."
  local hooks_dir="$target_dir/hooks"
  if [ ! -d "$hooks_dir" ] && [ -d "$target_dir/.git/hooks" ]; then
    hooks_dir="$target_dir/.git/hooks"
  fi

  if [ -d "$hooks_dir" ]; then
    for hk in "$hooks_dir/"*; do
      [ -e "$hk" ] || continue
      local hname
      hname=$(basename "$hk")
      [[ "$hname" == *.sample ]] && continue
      if [ -f "$hk" ]; then
        if [ ! -x "$hk" ]; then
          echo "   ⚠️  Held item '$hname' is not equipped (chmod +x needed)."
          issues=$((issues + 1))
        else
          echo "   ✅ Held item '$hname' equipped"
        fi
      fi
    done
  else
    echo "   ℹ️  No hooks found."
  fi

  echo "──────────────────────────────────────────────"
  if [ "$issues" -eq 0 ]; then
    echo "✨ Harnemon is in peak condition! 3-Pillar stats and self-evolution verified."
  else
    echo "⚠️  Found $issues health check issue(s). Treat with Harnemon recommendations."
  fi
}

cmd_dex() {
  echo "📖 [Harnedex / 하네몬 도감] Legendary Harnemon Archetypes"
  echo "──────────────────────────────────────────────"
  echo "No.001 루티스 (Routis)      — 민첩/강철 타입"
  echo "       • Jihan Harness: 50토큰 스킬 라우터, 제로 디펜던시, 루트 클린"
  echo "       • Entry: docs/case-studies/01-jihan-harness.md"
  echo ""
